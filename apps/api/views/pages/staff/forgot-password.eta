<%/* /staff/forgot-password: emails a link to /staff/set-password. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Forgot Password | VERGO Staffing",
    "description": "Get a link to set a new password for your VERGO staff account.",
    "ogImage": "/images/og/work.jpg",
    "robots": "noindex",
    "canonical": "/staff/forgot-password"
  },
  scripts: ["/pages/js/staff-auth.js"],
  header: {"focused":"1","back":"/staff/login","label":"← Back to login"}
}) %>
    <section class="page-hero-plain shell-form">
      <span class="eyebrow">Staff</span>
      <h1>Forgot your password?</h1>
      <p class="lede">Give us the email address you sign in with and we will send you a link to choose a new one.</p>
    </section>

    <section class="section-tight shell-form">
      <form id="staffForgot" data-staff-form="forgot" novalidate>
        <div class="form-field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" autocomplete="email" required>
        </div>

        <div class="form-status" id="staffStatus" role="status" hidden></div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-block">Send me a link</button>
        </div>
      </form>
    </section>
