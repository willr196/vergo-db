<%/* /birmingham: the location page. Same rates, roles and promises as London, from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Event Staff Hire in Birmingham | VERGO Staffing",
    "description": `Waiting, bar and kitchen staff, runners and hosts across Birmingham. ${it.t.HEADLINE_RATE} per person, ${it.t.MIN_HOURS}-hour minimum.`,
    "ogImage": "/images/og/hire.jpg",
    "canonical": "/birmingham"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Event and hospitality staffing in Birmingham",
      "serviceType": "Event and hospitality staffing",
      "url": "https://vergoltd.com/birmingham",
      "description": "Waiting staff, bar staff, kitchen porters, runners, hosts and front of house for events across Birmingham.",
      "areaServed": {
        "@type": "City",
        "name": "Birmingham"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://vergoltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Birmingham",
          "item": "https://vergoltd.com/birmingham"
        }
      ]
    }
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Birmingham</span>
      <h1>Event staff in Birmingham</h1>
      <%~ include('/partials/city-switch', { current: "birmingham" }) %>
      <p class="home-slogan"><%~ it.t.SLOGAN %></p>
      <p class="lede"><a href="/hire/waiting-staff">Waiting</a>, <a href="/hire/bar-staff">bar</a>, <a href="/hire/kitchen-porters">kitchen porters</a>, runners, hosts. Same staff standards, same rates as London.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <%~ it.blocks["rates"]() %>

    <section class="section shell" aria-labelledby="where-heading">
      <h2 id="where-heading" class="section-label">Where we cover</h2>
      <p>Birmingham is new for us, and we're taking first bookings now across city-centre venues, the NEC and ICC, Digbeth, the Jewellery Quarter and private venues. Put the venue postcode on your quote and we'll confirm names.</p>
    </section>

    <section class="section shell" aria-labelledby="howitworks-heading">
      <h2 id="howitworks-heading" class="section-label">How it works</h2>
      <div class="step-grid step-grid--3">
        <div class="step">
          <div class="step-number">01</div>
          <h3>Send details</h3>
          <p>Date, times, roles.</p>
        </div>
        <div class="step">
          <div class="step-number">02</div>
          <h3>Get names</h3>
          <p>Names, not numbers.</p>
        </div>
        <div class="step">
          <div class="step-number">03</div>
          <h3>They arrive briefed</h3>
          <p>Venue and running order.</p>
        </div>
      </div>
    </section>

    <%~ it.blocks["working-with-us"]() %>

    <section class="section shell" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-label">Work in Birmingham</h2>
      <p>We are building our Birmingham team now: if you have waiting, bar or kitchen experience and live nearby, <a href="/work/apply">apply here</a>.</p>
    </section>

    <section class="section shell" aria-labelledby="byoccasion-heading">
      <h2 id="byoccasion-heading" class="section-label">By occasion</h2>
      <ul class="link-tiles">
        <li><a href="/hire/weddings">Weddings</a></li>
        <li><a href="/hire/production-catering">Film and TV</a></li>
        <li><a href="/special-events/christmas">Christmas</a></li>
        <li><a href="/special-events">Themed events</a></li>
      </ul>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Got a date in Birmingham?" }) %>
