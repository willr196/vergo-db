# VERGO API — environment template.
#
# Copy to .env for local development. Values here are placeholders, never real
# credentials. Anything marked REQUIRED IN PRODUCTION will stop the API booting
# (or disable part of it) if missing when NODE_ENV=production — set those on Fly
# with `fly secrets set`, and verify the DIGEST column of `fly secrets list`
# actually changed afterwards. `fly secrets set` reports success even when the
# value it received was empty.
#
# Generate any secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Secrets must be at least 32 bytes and must not be a placeholder word.

NODE_ENV=development
PORT=3000

# ---- Database (REQUIRED everywhere) ----
DATABASE_URL=postgresql://user:password@localhost:5432/vergo
# Direct (non-pooled) connection, used by migrations.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/vergo
# Guard rail: migrations refuse a remote target unless this is set. See
# docs/database-environments.md. Do not set this locally.
# ALLOW_REMOTE_DB=1

# ---- Secrets (REQUIRED IN PRODUCTION) ----
# Mobile JWTs. JWT_REFRESH_SECRET must differ from JWT_SECRET in production.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Web session cookie (vergo.sid).
SESSION_SECRET=
# Admin panel CSRF. Without it the public site still serves, but every admin
# state-changing request returns 503 CSRF_MISCONFIGURED.
CSRF_SECRET=

# ---- Origins ----
# Must be https:// in production or the API refuses to boot.
WEB_ORIGIN=http://localhost:8080
BASE_URL=http://localhost:3000

# ---- Email (Resend) ----
# NOTE: a real key here sends real email from local dev. Clear it before testing forms.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Falls back to wrobb@vergoltd.com when unset.
RESEND_TO_EMAIL=
# REQUIRED IN PRODUCTION for inbound webhook verification.
RESEND_WEBHOOK_SECRET=
# ALLOW_TEST_EMAILS=false
# EMAIL_QUEUE_ENABLED=false

# ---- Storage (S3) ----
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local CV uploads are allowed automatically outside production.
# ALLOW_LOCAL_CV_UPLOADS=true
# LOCAL_CV_UPLOAD_ROOT=/tmp/vergo-cv-uploads

# ---- Seeding (prisma/seed.ts) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Optional ----
# REDIS_URL=
# SENTRY_DSN=
# LOG_LEVEL=info
# EXPOSE_DEV_VERIFICATION_LINKS=true   # non-production only
# TEST_DATABASE_URL=
