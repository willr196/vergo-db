<%/*
  The live seasonal offers, decided on the server (site/view.ts seasonState).
  Nothing at all outside a season. vergo-site.js only handles the close
  button: a dismissal lasts for the visit, and only for this set of offers
  (data-season-keys), so a new season shows again.
*/%>
<% if (it.season.banner.length) { %>
<div class="season-banner" data-season-banner data-season-keys="<%= it.season.banner.map(function (p) { return p.key; }).join('+') %>">
    <div class="season-banner-inner">
      <p class="season-banner-links" data-season-banner-links><% it.season.banner.forEach(function (p) { %><span><a href="<%= p.href %>"><%= p.bannerText %> →</a></span><% }) %></p>
      <button type="button" class="season-banner-close" data-season-dismiss aria-label="Dismiss this notice">&times;</button>
    </div>
  </div>
<% } %>
