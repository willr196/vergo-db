enum OpsLeadChannel {
  EMAIL
  PHONE
  IN_PERSON
  OTHER
}

enum OpsLeadStage {
  CONTACTED
  REPLIED
  WON
  LOST
}

/// VERGO Ops: one line of a booking's running order (arrival, briefing, doors,
