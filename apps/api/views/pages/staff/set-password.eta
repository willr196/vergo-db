<%/* /staff/set-password?token=...: one page for a first login (invite or roster
     welcome), a forgotten password, and a forced change. Posts to
     /api/v1/user/reset-password. The heading changes with ?invite=1. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Set Your Password | VERGO Staffing",
    "description": "Choose a password for your VERGO staff account.",
    "ogImage": "/images/og/work.jpg",
    "robots": "noindex",
    "canonical": "/staff/set-password"
  },
  scripts: ["/pages/js/staff-auth.js"],
  header: {"focused":"1","back":"/staff/login","label":"← Back to login"}
}) %>
    <section class="page-hero-plain shell-form">
      <span class="eyebrow">Staff</span>
      <h1 id="setPasswordHeading">Choose a new password</h1>
      <p class="lede" id="setPasswordLede">At least 8 characters. Something you don't use anywhere else.</p>
    </section>

    <section class="section-tight shell-form">
      <form id="staffSetPassword" data-staff-form="set-password" novalidate>
        <div class="form-field">
          <label for="password">New password</label>
          <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" required>
        </div>
        <div class="form-field">
          <label for="confirm">Type it again</label>
          <input type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="8" maxlength="72" required>
        </div>

        <div class="form-status" id="staffStatus" role="status" hidden></div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-block">Save password</button>
        </div>
      </form>
    </section>
