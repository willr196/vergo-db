<%/* /special-events/halloween: moved from public/special-events/halloween.html. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Halloween Event Staff & Performers London | VERGO Staffing",
    "description": "Halloween event staff, themed bartenders, scare actors, character performers, makeup artists, decorators and costumed event teams across London from VERGO.",
    "ogImage": "/images/og/halloween.jpg",
    "canonical": "/special-events/halloween"
  },
  styles: ["/pages/css/special-events.css"],
  scripts: ["/pages/js/halloween-team.js"],
  bodyClass: "se-page se-theme-halloween",
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Halloween event staff and performers",
      "serviceType": "Themed and immersive event staffing",
      "url": "https://vergoltd.com/special-events/halloween",
      "description": "Halloween event staff, themed bartenders, scare actors, character performers, makeup artists, decorators and costumed event teams across London from VERGO.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Halloween staffing and performance",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Themed hospitality staff"
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": Number(it.t.THEMED_RATE_NUMBER),
              "priceCurrency": "GBP",
              "unitCode": "HUR",
              "unitText": "per hour",
              "referenceQuantity": {
                "@type": "QuantitativeValue",
                "value": Number(it.t.MIN_HOURS),
                "unitCode": "HUR"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Halloween hosts"
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": Number(it.t.THEMED_RATE_NUMBER),
              "priceCurrency": "GBP",
              "unitCode": "HUR",
              "unitText": "per hour",
              "referenceQuantity": {
                "@type": "QuantitativeValue",
                "value": Number(it.t.MIN_HOURS),
                "unitCode": "HUR"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Scare actors"
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": Number(it.t.PERFORMER_RATE_NUMBER),
              "priceCurrency": "GBP",
              "unitCode": "HUR",
              "unitText": "per hour",
              "referenceQuantity": {
                "@type": "QuantitativeValue",
                "value": Number(it.t.MIN_HOURS),
                "unitCode": "HUR"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Character performers"
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": Number(it.t.PERFORMER_RATE_NUMBER),
              "priceCurrency": "GBP",
              "unitCode": "HUR",
              "unitText": "per hour",
              "referenceQuantity": {
                "@type": "QuantitativeValue",
                "value": Number(it.t.MIN_HOURS),
                "unitCode": "HUR"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Halloween makeup artists and SFX"
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": Number(it.t.MAKEUP_RATE_NUMBER),
              "priceCurrency": "GBP",
              "unitCode": "HUR",
              "unitText": "per hour",
              "referenceQuantity": {
                "@type": "QuantitativeValue",
                "value": Number(it.t.MIN_HOURS),
                "unitCode": "HUR"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Guest makeup stations"
            },
            "availability": "https://schema.org/LimitedAvailability"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Specialist performers, including fire performers, stilt walkers and contortionists"
            },
            "availability": "https://schema.org/LimitedAvailability"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Costumes and styling"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Decorators and set dressing"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Event and character leads"
            }
          }
        ]
      }
    },
    it.faqJsonLd("special-events/halloween"),
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://vergoltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Special events",
          "item": "https://vergoltd.com/special-events"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Halloween",
          "item": "https://vergoltd.com/special-events/halloween"
        }
      ]
    }
  ]
}) %>

    <!-- ================================================================
         Hero. Artwork lives in --se-hero-img (special-events.css).
         ================================================================ -->
    <section class="se-hero">
      <div class="se-hero-inner">
        <span class="eyebrow">Halloween by VERGO</span>
        <h1>Halloween event staff and performers in London</h1>
        <p class="lede">Themed staff, performers, makeup and decor across London.</p>
        <div class="btn-row">
          <a href="#build" class="btn btn-primary">Build your team</a>
        </div>
      </div>
    </section>

    <section class="section-tight shell" aria-label="Halloween staff in costume">
      <div class="se-photo-pair se-photo-pair--half">
        <figure>
          <img src="/images/special-events/halloween-bar-800.webp" srcset="/images/special-events/halloween-bar-800.webp 800w, /images/special-events/halloween-bar-1200.webp 1200w" sizes="(min-width: 700px) 294px, 50vw" width="1448" height="1086" loading="lazy"
               alt="Bartenders in hooded robes and ghost masks pouring cocktails at a candlelit Halloween bar">
          <figcaption>Styling example: themed bar</figcaption>
        </figure>
        <figure>
          <img src="/images/special-events/halloween-waiting-staff-800.webp" srcset="/images/special-events/halloween-waiting-staff-800.webp 800w, /images/special-events/halloween-waiting-staff-1200.webp 1200w" sizes="(min-width: 700px) 294px, 50vw" width="1448" height="1086" loading="lazy"
               alt="Waiting staff dressed as a vampire, a mummy, a werewolf and Frankenstein's monster serving drinks and canapés at a Halloween dinner">
          <figcaption>Styling example: waiting staff in character</figcaption>
        </figure>
      </div>
    </section>

    <!-- ================================================================
         Three levels
         ================================================================ -->
    <div class="se-band se-band--deep">
      <section class="section shell" id="approach" aria-labelledby="approach-heading">
        <h2 id="approach-heading" class="se-h2">Three levels</h2>

        <div class="se-involve-grid">
          <article class="se-involve">
            <span class="se-involve-num" aria-hidden="true">01</span>
            <h3>Dress the team</h3>
              <p class="se-involve-sub">Themed bartenders, waiting staff, character hosts, costume, makeup.</p>
          </article>

          <article class="se-involve">
            <span class="se-involve-num" aria-hidden="true">02</span>
            <h3>Bring the characters</h3>
              <p class="se-involve-sub">Scare actors, roaming characters, vampires, zombies, creepy clowns.</p>
          </article>

          <article class="se-involve">
            <span class="se-involve-num" aria-hidden="true">03</span>
            <h3>Build the experience</h3>
              <p class="se-involve-sub">Staff, performers, makeup, costumes, immersive elements.</p>
          </article>
        </div>
      </section>
    </div>

    <!-- ================================================================
         Concepts. Titles sit on the artwork; the chips are the content.
         Swap --se-concept-img per card for real photography.
         ================================================================ -->
    <section class="section shell" id="concepts" aria-labelledby="concepts-heading">
      <h2 id="concepts-heading" class="se-h2">Five concepts</h2>

      <div class="se-concept-grid">
        <article class="se-concept se-concept--feature" style="--se-c1: #2b2015; --se-c2: #0a0908; --se-concept-img: url(&quot;/images/special-events/concept-haunted-hotel.svg&quot;)">
          <div class="se-concept-inner">
            <div class="se-concept-media" role="presentation">
              <h3 class="se-concept-title">The Haunted Hotel</h3>
            </div>
            <div class="se-concept-body">
              <p class="se-concept-chars">Concierge, Bellboy, Housekeeping, Ghost guests, Haunted bartender</p>
            </div>
          </div>
        </article>

        <article class="se-concept" style="--se-c1: #232612; --se-c2: #09090a; --se-concept-img: url(&quot;/images/special-events/concept-outbreak.svg&quot;)">
          <div class="se-concept-inner">
            <div class="se-concept-media" role="presentation">
              <h3 class="se-concept-title">The Outbreak</h3>
            </div>
            <div class="se-concept-body">
              <p class="se-concept-chars">Scientists, Doctors, Containment staff, Infected workers, Zombies</p>
            </div>
          </div>
        </article>

        <article class="se-concept" style="--se-c1: #2d1318; --se-c2: #0a0708; --se-concept-img: url(&quot;/images/special-events/concept-vampire-ball.svg&quot;)">
          <div class="se-concept-inner">
            <div class="se-concept-media" role="presentation">
              <h3 class="se-concept-title">The Vampire Ball</h3>
            </div>
            <div class="se-concept-body">
              <p class="se-concept-chars">Vampire hosts, Gothic bartenders, Waiting staff, Roaming performers</p>
            </div>
          </div>
        </article>

        <article class="se-concept" style="--se-c1: #33220f; --se-c2: #0b0907; --se-concept-img: url(&quot;/images/special-events/concept-twisted-circus.svg&quot;)">
          <div class="se-concept-inner">
            <div class="se-concept-media" role="presentation">
              <h3 class="se-concept-title">The Twisted Circus</h3>
            </div>
            <div class="se-concept-body">
              <p class="se-concept-chars">Ringmaster, Clowns, Carnival characters, Roaming performers</p>
            </div>
          </div>
        </article>

        <article class="se-concept" style="--se-c1: #221e19; --se-c2: #08080a; --se-concept-img: url(&quot;/images/special-events/concept-seance.svg&quot;)">
          <div class="se-concept-inner">
            <div class="se-concept-media" role="presentation">
              <h3 class="se-concept-title">The S&eacute;ance</h3>
            </div>
            <div class="se-concept-body">
              <p class="se-concept-chars">Medium, Victorian hosts, Ghosts, Paranormal characters</p>
            </div>
          </div>
        </article>
      </div>

    </section>

    <!-- Decor themes: venue dressing, quoted on the brief. Our own themes, no licensed names. -->
    <div class="se-band">
      <section class="section shell" id="decor" aria-labelledby="decor-heading">
        <h2 id="decor-heading" class="se-h2">Decor themes</h2>
        <p class="se-caveat">Suggestions to start from. Mix them, or bring your own.</p>
        <div class="se-decor-grid">
          <article class="se-decor">
            <span class="se-service-idx" aria-hidden="true">01</span>
            <h3>Classic Halloween</h3>
            <p>Webs, spiders, bats, pumpkins, skeletons.</p>
          </article>
          <article class="se-decor">
            <span class="se-service-idx" aria-hidden="true">02</span>
            <h3>Ghouls, Ghosts &amp; the Undead</h3>
            <p>Graveyard mist, shrouds, the risen dead.</p>
          </article>
          <article class="se-decor">
            <span class="se-service-idx" aria-hidden="true">03</span>
            <h3>The Gates of Hell</h3>
            <p>Red light, chains, smoke and fire.</p>
          </article>
          <article class="se-decor">
            <span class="se-service-idx" aria-hidden="true">04</span>
            <h3>Witches&rsquo; Nightmare</h3>
            <p>Cauldrons, candles, hexes and herbs.</p>
          </article>
          <article class="se-decor">
            <span class="se-service-idx" aria-hidden="true">05</span>
            <h3>Killer Clown Asylum</h3>
            <p>Padded cells, straitjackets, carnival gone wrong.</p>
          </article>
          <article class="se-decor">
            <span class="se-service-idx" aria-hidden="true">06</span>
            <h3>Skeleton After-Party</h3>
            <p>Glowing bones, neon, a dance floor.</p>
          </article>
          <a class="se-decor se-decor--more" href="#build">
            <span class="se-service-idx" aria-hidden="true">+</span>
            <h3>Your own theme</h3>
            <p>Or a mix. Tell us the idea.</p>
          </a>
        </div>
        <div class="btn-row se-makeup-cta">
          <a href="#build" class="btn btn-primary">Theme your venue</a>
        </div>
      </section>
    </div>
    <!-- ================================================================
         Makeup
         ================================================================ -->
    <div class="se-band se-band--deep">
      <section class="section shell" id="makeup" aria-labelledby="makeup-heading">
        <h2 id="makeup-heading" class="se-h2">Makeup and SFX</h2>

        <ul class="se-makeup-lines">
          <li><strong>Staff and performer makeup:</strong> wounds, bruising, fake blood, zombie, vampire, ghost, aging, prosthetics.</li>
          <li><strong>Guest makeup stations:</strong> corporate parties, hotels, bars, private parties, brand events, members' clubs.</li>
        </ul>

        <div class="btn-row se-makeup-cta">
          <a href="#build" class="btn btn-primary">Add makeup to your event</a>
        </div>
      </section>
    </div>

    <!-- ================================================================
         Halloween events: drinks and food, all optional add-ons
         ================================================================ -->
    <section class="section shell" id="drinks-food" aria-labelledby="drinks-food-heading">
      <h2 id="drinks-food-heading" class="se-h2">Halloween events: drinks and food</h2>
      <p class="se-caveat">Want more than the team? We can run the whole event, and every part is optional: take one, take all, or bring your own.</p>

      <ul class="se-makeup-lines">
        <li><strong>You buy the drinks, we run the bar:</strong> bar setup, glassware, ice, mixers, garnishes and themed bartenders.</li>
        <li><strong>We supply the drinks:</strong> only at venues with a premises licence.</li>
        <li><strong>Halloween cocktails:</strong> a themed menu, smoking and blood-red serves, mocktails too.</li>
        <li><strong>Halloween food:</strong> themed canap&eacute;s, bowl food and sweet treats, served in character.</li>
      </ul>

      <div class="btn-row se-makeup-cta">
        <a href="#build" class="btn btn-primary">Add drinks or food</a>
      </div>
    </section>

    <!-- Rates: the figures are tokens filled from config/pricing.ts as the page is served. -->
    <section class="section shell" id="rates" aria-labelledby="rates-heading">
      <h2 id="rates-heading" class="se-h2">Rates</h2>

      <div class="se-rate-grid">
        <article class="se-rate">
          <p class="se-rate-tag">Hospitality</p>
          <h3>Themed hospitality staff</h3>
          <p class="se-rate-price">
            <span class="se-rate-figure"><%~ it.t.THEMED_RATE %></span>
            <span class="se-rate-unit">per hour</span>
          </p>
          <p class="se-rate-copy">Waiters, bartenders, runners and hosts, styled to your theme.</p>
        </article>
        <article class="se-rate">
          <p class="se-rate-tag">Performers</p>
          <h3>Scare actors and character performers</h3>
          <p class="se-rate-price">
            <span class="se-rate-figure"><%~ it.t.PERFORMER_RATE %></span>
            <span class="se-rate-unit">per hour</span>
          </p>
          <p class="se-rate-copy">Actors cast for your concept, intensity set to suit.</p>
        </article>
        <article class="se-rate">
          <p class="se-rate-tag">Makeup</p>
          <h3>Halloween makeup artists</h3>
          <p class="se-rate-price">
            <span class="se-rate-figure"><%~ it.t.MAKEUP_RATE %></span>
            <span class="se-rate-unit">per hour</span>
          </p>
          <p class="se-rate-copy">Halloween makeup, character styling and straightforward SFX.</p>
        </article>
      </div>
      <p class="se-rates-invite">Specialist performers, decor and full experiences: quoted on the brief. <%~ it.t.MIN_HOURS %>-hour minimum.</p>
      <p class="se-caveat">Themed staff wear the look; performers are cast to act.</p>
      <p class="se-caveat">What a whole night costs, worked through: <a href="/blog/halloween-event-staff-london">Halloween event staff in London</a>.</p>
      <div class="btn-row se-rates-cta">
        <a href="#build" class="btn btn-primary">Build your Halloween team</a>
      </div>
    </section>

    <!-- ================================================================
         Enquiry — posts to the existing quote endpoint as an ENQUIRY.
         See /pages/js/halloween-team.js.
         ================================================================ -->
    <div class="se-form-section">
      <section class="section se-form-shell" id="build" aria-labelledby="build-heading">
        <div class="se-form-head">
          <p class="section-label">Enquiry</p>
          <h2 id="build-heading">Build your team</h2>
          <p>Nothing here is binding, and every question is optional. Tap a choice again to clear it.</p>
        </div>

        <form id="halloweenForm" novalidate data-se-brief data-event-type="Halloween (Special Events)" data-brief-label="Halloween / special events brief">
          <div class="hp-field" aria-hidden="true">
            <label for="hwWebsite">Website</label>
            <input type="text" id="hwWebsite" name="website" tabindex="-1" autocomplete="off">
          </div>

          <fieldset class="se-fieldset" id="needsField">
            <legend>What do you need?</legend>
            <div class="se-need-grid checkbox-grid">
              <div class="checkbox-item">
                <input type="checkbox" id="need-staff" name="need" value="Event staff">
                <label for="need-staff">Event staff</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-bar" name="need" value="Themed bartenders">
                <label for="need-bar">Themed bartenders</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-waiting" name="need" value="Waiting staff">
                <label for="need-waiting">Waiting staff</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-hosts" name="need" value="Hosts">
                <label for="need-hosts">Hosts</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-performers" name="need" value="Character performers">
                <label for="need-performers">Character performers</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-scare" name="need" value="Scare actors">
                <label for="need-scare">Scare actors</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-makeup" name="need" value="Makeup artists">
                <label for="need-makeup">Makeup artists</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-station" name="need" value="Guest makeup station">
                <label for="need-station">Guest makeup station</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-costume" name="need" value="Costumes and styling">
                <label for="need-costume">Costumes / styling</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-decorators" name="need" value="Decorators and set dressing">
                <label for="need-decorators">Decorators &amp; set dressing</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-lead" name="need" value="Event or character lead">
                <label for="need-lead">Event / character lead</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-drinks" name="need" value="Drinks supplied (we bring the bar)">
                <label for="need-drinks">We bring the drinks</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-cocktails" name="need" value="Halloween cocktail menu">
                <label for="need-cocktails">Halloween cocktails</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-food" name="need" value="Halloween food">
                <label for="need-food">Halloween food</label>
              </div>
              <div class="checkbox-item">
                <input type="checkbox" id="need-planning" name="need" value="Help planning the whole experience">
                <label for="need-planning">Whole experience</label>
              </div>
            </div>
          </fieldset>

          <fieldset class="se-fieldset">
            <legend>Decor theme</legend>
            <p class="form-hint">Only if you want the venue dressed.</p>
            <div class="se-pillset">
              <label class="se-pill"><input type="radio" name="decorTheme" value="Classic Halloween"><span>Classic Halloween</span></label>
              <label class="se-pill"><input type="radio" name="decorTheme" value="Ghouls, Ghosts &amp; the Undead"><span>Ghouls &amp; Ghosts</span></label>
              <label class="se-pill"><input type="radio" name="decorTheme" value="The Gates of Hell"><span>Gates of Hell</span></label>
              <label class="se-pill"><input type="radio" name="decorTheme" value="Witches&rsquo; Nightmare"><span>Witches&rsquo; Nightmare</span></label>
              <label class="se-pill"><input type="radio" name="decorTheme" value="Killer Clown Asylum"><span>Killer Clown Asylum</span></label>
              <label class="se-pill"><input type="radio" name="decorTheme" value="Skeleton After-Party"><span>Skeleton After-Party</span></label>
            </div>
            <div class="form-field se-theme-idea">
              <label for="hwThemeIdea">Your theme or idea</label>
              <input type="text" id="hwThemeIdea" name="themeIdea" maxlength="300" placeholder="Describe the look you want, or mix a few">
            </div>
          </fieldset>
          <fieldset class="se-fieldset">
            <legend>Atmosphere</legend>
            <div class="se-pillset">
              <label class="se-pill"><input type="radio" name="atmosphere" value="Fun"><span>Fun</span></label>
              <label class="se-pill"><input type="radio" name="atmosphere" value="Atmospheric"><span>Atmospheric</span></label>
              <label class="se-pill"><input type="radio" name="atmosphere" value="Eerie"><span>Eerie</span></label>
              <label class="se-pill"><input type="radio" name="atmosphere" value="Scary"><span>Scary</span></label>
              <label class="se-pill"><input type="radio" name="atmosphere" value="Full horror"><span>Full horror</span></label>
            </div>
          </fieldset>

          <fieldset class="se-fieldset">
            <legend>Interaction</legend>
            <div class="se-pillset">
              <label class="se-pill"><input type="radio" name="interaction" value="Look the part"><span>Look the part</span></label>
              <label class="se-pill"><input type="radio" name="interaction" value="Talk to guests"><span>Talk to guests</span></label>
              <label class="se-pill"><input type="radio" name="interaction" value="Fully interactive / immersive"><span>Fully immersive</span></label>
            </div>
          </fieldset>

          <fieldset class="se-fieldset">
            <legend>Your event</legend>
            <p class="form-hint">Leave anything blank. We only need an email or phone number to reply.</p>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="hwName">Name</label>
                <input type="text" id="hwName" name="name" autocomplete="name">
              </div>
              <div class="form-field">
                <label for="hwCompany">Company</label>
                <input type="text" id="hwCompany" name="company" autocomplete="organization">
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="hwEmail">Email</label>
                <input type="email" id="hwEmail" name="email" autocomplete="email">
              </div>
              <div class="form-field">
                <label for="hwPhone">Phone</label>
                <input type="tel" id="hwPhone" name="phone" autocomplete="tel">
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="hwDate">Date</label>
                <input type="date" id="hwDate" name="eventDate">
              </div>
              <div class="form-field">
                <label for="hwLocation">Location</label>
                <input type="text" id="hwLocation" name="location" autocomplete="address-level2" placeholder="e.g. Shoreditch, E1">
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="hwGuests">Guests</label>
                <input type="number" id="hwGuests" name="guestCount" min="1" max="100000" step="1" inputmode="numeric" placeholder="e.g. 150">
              </div>
              <div class="form-field">
                <label for="hwHours">Hours</label>
                <input type="number" id="hwHours" name="hours" min="1" max="24" step="1" inputmode="numeric" placeholder="e.g. 5">
              </div>
            </div>

            <div class="form-field">
              <label for="hwMessage">The event</label>
              <textarea id="hwMessage" name="message" maxlength="2000" placeholder="Venue, idea, anything you are unsure about."></textarea>
            </div>
          </fieldset>

          <div class="se-form-actions">
            <button type="submit" class="btn btn-primary btn-block" id="hwSubmit">Build my Halloween team</button>
            <p class="se-form-reassure">Not sure what you need? Send the event and we&rsquo;ll recommend a team.</p>
          </div>

          <div class="form-status" id="hwStatus" role="status" hidden></div>
        </form>
      </section>
    </div>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="se-h2">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("special-events/halloween"), name: "halloween-faq", esc: it.esc }) %>
      </div>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Planning Halloween?", "line": "Now booking 23–24 and 30–31 October.", "button": "Build your Halloween team", "href": "#build" }) %>
