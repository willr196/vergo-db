generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Applicant {
  id                String                 @id @default(cuid())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  firstName         String
  lastName          String
  email             String                 @unique
  phone             String?
  /// Self-declared on the application form. NOT evidence of a right-to-work
  /// check — see the RightToWorkCheck records for the verified position.
  rightToWorkUk     Boolean?
  averageRating     Decimal?               @db.Decimal(3, 2)
  availability      String?
  bio               String?
  city              String?
  dateOfBirth       DateTime?
  hourlyRate        Decimal?               @db.Decimal(10, 2)
  postcode          String?
  /// Event types the applicant prefers to work (Weddings, Corporate Events, etc.)
  preferredJobTypes String?
  /// Job roles the applicant is suited for (bartender, chef, etc.) — a
  /// different concept from preferredJobTypes above, despite the similar name.
  preferredRoles    String[]               @default([])
  profileVisible    Boolean                @default(false)
  promotedToGoldAt  DateTime?
  staffTier         String                 @default("STANDARD")
  totalBookings     Int                    @default(0)
  yearsExperience   Int?
  applications      Application[]
  user              User?
  rightToWorkChecks RightToWorkCheck[]
  groups            CandidateGroupMember[]
}

/// Evidence of a completed right-to-work check. One row per check performed;
/// List B (time-limited) permissions require a follow-up check before expiresAt,
/// so history is retained rather than overwritten.
model RightToWorkCheck {
  id                       String     @id @default(cuid())
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  applicantId              String
  method                   RtwMethod
  /// e.g. "UK passport", "Share code", "BRP" — free text so the List A/B
  /// document names can change without a migration.
  documentType             String?    @db.VarChar(120)
  /// Share code or document number.
  reference                String?    @db.VarChar(120)
  validFrom                DateTime?
  /// Null means permanent right to work (List A). A date means a follow-up
  /// check is required before it lapses.
  expiresAt                DateTime?
  outcome                  RtwOutcome @default(PENDING)
  /// Admin username who performed the check.
  checkedBy                String     @db.VarChar(100)
  checkedAt                DateTime   @default(now())
  /// S3 key for the retained copy of the document evidence.
  documentKey              String?    @db.VarChar(500)
  notes                    String?    @db.VarChar(1000)
  /// VERGO Ops: the person who actually performed the check, when that is not
  /// the admin recording it.
  performedBy              String?    @db.VarChar(100)
  /// VERGO Ops: the admin's positive statement that the prescribed check was
  /// carried out. Null on checks recorded before this field existed. An upload
  /// on its own is never treated as proof that the check happened.
  prescribedCheckConfirmed Boolean?
  /// VERGO Ops: date a follow-up check is due, when one is needed before expiry.
  followUpDue              DateTime?
  // Restrict, not Cascade: this is compliance evidence and must survive an
  // applicant record being deleted. There is no applicant-delete path today,
  // but the FK shouldn't rely on that staying true — deleting an applicant
  // with RTW history should fail loudly rather than silently erase it.
  applicant                Applicant  @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@index([applicantId])
  @@index([outcome])
  @@index([expiresAt])
}

/// Admin-named shortlists ("Good bartenders", "Reliable for weddings").
/// Membership is per person, not per application, and one person can sit in
/// several groups.
model CandidateGroup {
  id        String                 @id @default(cuid())
  createdAt DateTime               @default(now())
  name      String                 @unique @db.VarChar(80)
  members   CandidateGroupMember[]
}

model CandidateGroupMember {
  groupId     String
  applicantId String
  addedAt     DateTime       @default(now())
  addedBy     String?        @db.VarChar(100)
  group       CandidateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  applicant   Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@id([groupId, applicantId])
  @@index([applicantId])
}

model Role {
  id           String            @id @default(cuid())
  name         String            @unique
  applications ApplicationRole[]
  jobs         Job[]
}

model ApplicationRole {
  applicationId   String
  roleId          String
  experienceLevel String?
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role            Role        @relation(fields: [roleId], references: [id])

  @@id([applicationId, roleId])
  @@map("ApplicationRole")
}

model Application {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  status         ApplicationStatus @default(RECEIVED)
  cvKey          String
  source         String?
  applicantId    String
  cvOriginalName String?
  notes          String?
  updatedAt      DateTime          @updatedAt
  cvFileSize     Int?
  cvMimeType     String?
  cvUploadedAt   DateTime?
  applicant      Applicant         @relation(fields: [applicantId], references: [id])
  roles          ApplicationRole[]

  @@index([status, createdAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  password           String
  createdAt          DateTime  @default(now())
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)

  @@index([username])
}

model Client {
  id                    String               @id @default(cuid())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  companyName           String
  industry              String?
  website               String?
  vatNumber             String?
  companySize           String?
  contactName           String
  email                 String               @unique
  passwordHash          String
  phone                 String?
  jobTitle              String?
  status                ClientStatus         @default(PENDING)
  approvedAt            DateTime?
  approvedBy            String?
  rejectionReason       String?
  emailVerified         Boolean              @default(false)
  verifyToken           String?
  verifyTokenExp        DateTime?
  resetToken            String?
  resetTokenExp         DateTime?
  failedAttempts        Int                  @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  adminNotes            String?
  subscriptionTier      SubscriptionTier     @default(STANDARD)
  subscriptionStatus    SubscriptionStatus   @default(ACTIVE)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  logo                  String?
  postcode              String?
  description           String?
  address               String?
  city                  String?
  seqId                 Int                  @unique @default(autoincrement())
  /// VERGO Ops hirer record. companyName is the legal/business name and
  /// industry is the nature of business.
  tradingName           String?              @db.VarChar(200)
  billingAddress        String?              @db.VarChar(500)
  venueAddresses        String[]             @default([])
  paymentTerms          String?              @db.VarChar(200)
  clientType            ClientType           @default(BUSINESS_HIRER)
  termsVersion          String?              @db.VarChar(40)
  termsSentAt           DateTime?
  termsAcceptedAt       DateTime?
  termsAcceptedBy       String?              @db.VarChar(200)
  /// VERGO Ops: the usual charge rate (GBP/h), filled in on new bookings.
  defaultChargeRate     Decimal?             @db.Decimal(10, 2)
  bookings              Booking[]
  bookingTemplates      BookingTemplate[]
  opsBookings           OpsBooking[]
  opsBookingSeries      OpsBookingSeries[]
  /// VERGO Ops: the outreach lead this client was won from, if any.
  opsLead               OpsLead?
  directHireTracking    DirectHireTracking[]
  clientDocuments       ClientDocument[]
  documentLinks         DocumentLink[]
  jobs                  Job[]
  pushTokens            PushToken[]
  quoteRequests         QuoteRequest[]
  refreshTokens         RefreshToken[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  eventType     String
  eventDate     DateTime?
  eventEndDate  DateTime?
  location      String
  city          String?
  venue         String?
  staffCount    Int
  roles         String
  shiftStart    String?
  shiftEnd      String?
  description   String?
  budget        String?
  status        String       @default("NEW")
  adminNotes    String?
  quotedAmount  Decimal?     @db.Decimal(10, 2)
  quoteSentAt   DateTime?
  clientId      String
  requestedLane BookingLane?
  bookings      Booking[]
  opsBookings   OpsBooking[]
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([requestedLane])
}

model TermsVersion {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  version       String    @unique
  effectiveDate DateTime
  sections      Json
  publishedAt   DateTime?

  @@index([publishedAt])
}

model PricingTier {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  clientTier   SubscriptionTier
  staffTier    StaffTier
  hourlyRate   Decimal          @db.Decimal(10, 2)
  staffPayRate Decimal?         @db.Decimal(10, 2)
  isBookable   Boolean          @default(true)

  @@unique([clientTier, staffTier])
  @@map("PricingTier")
}

model SubscriptionPlan {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tier         SubscriptionTier @unique
  name         String
  weeklyPrice  Decimal          @db.Decimal(10, 2)
  monthlyPrice Decimal?         @db.Decimal(10, 2)
  annualPrice  Decimal?         @db.Decimal(10, 2)
  features     String?
  isActive     Boolean          @default(true)

  @@map("SubscriptionPlan")
}

model Booking {
  id                         String            @id @default(cuid())
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  status                     BookingStatus     @default(PENDING)
  eventName                  String?
  eventDate                  DateTime
  eventEndDate               DateTime?
  location                   String
  venue                      String?
  shiftStart                 String
  shiftEnd                   String
  hoursEstimated             Decimal?          @db.Decimal(5, 2)
  clientTierAtBooking        SubscriptionTier
  staffTierAtBooking         StaffTier
  hourlyRateCharged          Decimal           @db.Decimal(10, 2)
  staffPayRate               Decimal?          @db.Decimal(10, 2)
  totalEstimated             Decimal?          @db.Decimal(10, 2)
  clientNotes                String?
  adminNotes                 String?
  rejectionReason            String?
  confirmedAt                DateTime?
  confirmedBy                String?
  termsVersionAtConfirmation String?
  completedAt                DateTime?
  /// Worker check-in and check-out, recorded from the mobile app. hoursWorked
  /// is computed at check-out from these two and is what the timesheet reads.
  /// It records what was actually worked, so it is not floored at the four-hour
  /// minimum the client is charged for.
  checkedInAt                DateTime?
  checkedOutAt               DateTime?
  hoursWorked                Decimal?          @db.Decimal(5, 2)
  /// Anything the worker needs to flag at check-out: overrun, a problem on
  /// site, a task that took longer than briefed.
  workerShiftNotes           String?
  clientId                   String
  staffId                    String
  quoteRequestId             String?
  bookingLane                BookingLane       @default(FLEX)
  /// Set when the client is invoiced for this booking; starts the float clock.
  invoicedAt                 DateTime?
  /// +14 days from invoicedAt — when staff pay for this booking falls due.
  staffPayDueAt              DateTime?
  invoiceRef                 String?
  clientPaidAt               DateTime?
  staffPaidAt                DateTime?
  /// Set when this booking was generated from a BookingTemplate, so a
  /// re-run of that template's generation can't double-book the same day.
  templateId                 String?
  /// VERGO Ops: set when this row is an assignment on an Ops booking. The
  /// existing Booking row stays the worker's shift and the timesheet, so the
  /// app's check-in/out and the admin timesheet screen keep working as before.
  opsBookingId               String?
  requirementId              String?
  role                       String?           @db.VarChar(80)
  holidayPayMethod           HolidayPayMethod?
  /// Unpaid break, minutes. Worked hours are net of it.
  breakMins                  Int?
  /// When a worker is swapped out the old row is CANCELLED and points here.
  replacedByBookingId        String?
  /// Reason an admin gave for confirming despite a pre-assignment warning.
  warningOverrideReason      String?           @db.VarChar(500)
  timesheetClientApprovedAt  DateTime?
  timesheetClientApprovedBy  String?           @db.VarChar(200)
  timesheetAdminApprovedAt   DateTime?
  timesheetAdminApprovedBy   String?           @db.VarChar(100)
  timesheetDisputedAt        DateTime?
  timesheetDisputeReason     String?           @db.VarChar(500)
  client                     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteRequest               QuoteRequest?     @relation(fields: [quoteRequestId], references: [id])
  staff                      User              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  template                   BookingTemplate?  @relation(fields: [templateId], references: [id])
  review                     BookingReview?
  opsBooking                 OpsBooking?       @relation(fields: [opsBookingId], references: [id], onDelete: Restrict)
  requirement                OpsRequirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  workerDocuments            WorkerDocument[]

  @@unique([templateId, eventDate])
  @@index([clientId])
  @@index([staffId])
  @@index([status])
  @@index([bookingLane])
  @@index([eventDate])
  @@index([createdAt])
  @@index([clientPaidAt, staffPaidAt])
  @@index([checkedInAt, checkedOutAt])
  @@index([opsBookingId])
  @@index([staffId, eventDate])
}

model BookingTemplate {
  id                String      @id @default(cuid())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  name              String
  clientId          String
  staffId           String
  role              String?
  /// 1 = Monday .. 7 = Sunday (ISO weekday numbering).
  weekdays          Int[]
  shiftStart        String
  shiftEnd          String
  breakMins         Int         @default(0)
  /// Explicit rates take precedence over the client/staff tier's PricingTier
  /// rate, same precedence as manual booking creation.
  hourlyRateCharged Decimal?    @db.Decimal(10, 2)
  staffPayRate      Decimal?    @db.Decimal(10, 2)
  bookingLane       BookingLane @default(FLEX)
  active            Boolean     @default(true)
  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff             User        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  bookings          Booking[]

  @@index([clientId])
  @@index([staffId])
  @@index([active])
}

model Contact {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  name       String
  email      String
  phone      String?
  company    String?
  type       ContactType
  eventType  String?
  eventDate  DateTime?
  guests     Int?
  staffCount Int?
  roles      String?
  subject    String?
  message    String
  status     ContactStatus @default(NEW)
  adminNotes String?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model FileUploadVerification {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(500)
  applicantId String   @db.VarChar(36)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  verified    Boolean  @default(false)

  @@index([key])
  @@index([expiresAt])
}

model User {
  id                 String                  @id @default(cuid())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  email              String                  @unique
  passwordHash       String
  emailVerified      Boolean                 @default(false)
  verifyToken        String?
  resetToken         String?
  resetTokenExp      DateTime?
  firstName          String
  lastName           String
  phone              String?
  applicantId        String?                 @unique
  failedAttempts     Int                     @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  approvedClient     Boolean                 @default(false)
  billingAddress     String?
  companyName        String?
  companyWebsite     String?
  userType           UserType                @default(JOB_SEEKER)
  vatNumber          String?
  verifyTokenExp     DateTime?
  staffTier          StaffTier?
  staffBio           String?
  staffAvatar        String?
  staffAvailable     Boolean                 @default(false)
  /// Richer 3-state status shown in the app; staffAvailable above is kept in
  /// sync from this (AVAILABLE -> true, LIMITED/UNAVAILABLE -> false) since
  /// existing matching/marketplace logic reads the boolean.
  availabilityStatus StaffAvailabilityStatus @default(UNAVAILABLE)
  staffRating        Decimal?                @db.Decimal(3, 2)
  staffReviewCount   Int                     @default(0)
  staffHighlights    String?
  /// Gates employer NI on this person's bookings — casual/low-hours staff are
  /// nowhere near the NI threshold, so this defaults off rather than being
  /// inferred from hours worked.
  niLiable           Boolean                 @default(false)
  /// Gates employer pension contributions, same reasoning as niLiable.
  pensionEnrolled    Boolean                 @default(false)
  seqId              Int                     @unique @default(autoincrement())
  mustChangePassword Boolean                 @default(false)
  bookings           Booking[]
  bookingTemplates   BookingTemplate[]
  jobApplications    JobApplication[]
  jobAssignments     JobAssignment[]
  pushTokens         PushToken[]
  refreshTokens      RefreshToken[]
  savedJobs          SavedJob[]
  availability       Availability[]
  jobInvites         JobInvite[]
  applicant          Applicant?              @relation(fields: [applicantId], references: [id])
  workerProfile      WorkerProfile?
  workerDocuments    WorkerDocument[]
  documentLinks      DocumentLink[]
  historicPayments   HistoricPayment[]
  directHireTracking DirectHireTracking[]

  @@index([email])
  @@index([userType])
}

model RefreshToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  tokenHash String    @unique
  userId    String?
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
}

model PushToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique
  platform  String
  userId    String?
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

model Job {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  title          String
  description    String
  location       String
  roleId         String
  status         JobStatus        @default(DRAFT)
  closingDate    DateTime?
  companyName    String?
  eventDate      DateTime?
  eventEndDate   DateTime?
  externalUrl    String?
  payRate        Decimal?         @db.Decimal(10, 2)
  payType        PayType          @default(HOURLY)
  publishedAt    DateTime?
  requirements   String?
  shiftEnd       String?
  shiftStart     String?
  staffConfirmed Int              @default(0)
  staffNeeded    Int              @default(1)
  type           JobType          @default(INTERNAL)
  venue          String?
  clientId       String?
  posterEmail    String?
  client         Client?          @relation(fields: [clientId], references: [id])
  role           Role             @relation(fields: [roleId], references: [id])
  applications   JobApplication[]
  savedBy        SavedJob[]
  invites        JobInvite[]
  days           JobDay[]

  @@index([status, type])
  @@index([clientId])
  @@index([roleId])
  @@index([eventDate])
  @@index([publishedAt])
}

model JobApplication {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  jobId               String
  status              JobApplicationStatus @default(PENDING)
  adminNotes          String?
  rejectionReason     String?
  coverNote           String?
  userId              String
  applyIdempotencyKey String?              @unique
  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([status])
  @@index([createdAt])
}

/// One calendar day of a job. A multi-day event rarely needs the same crew size
/// on the build day as on the show day, so headcount lives here rather than only
/// on the job. Job.staffNeeded is kept in sync with the busiest single day.
model JobDay {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  jobId       String
  date        DateTime        @db.Date
  staffNeeded Int             @default(1)
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignments JobAssignment[]

  @@unique([jobId, date])
  @@index([jobId])
  @@index([date])
}

/// A named worker rostered onto one specific day of a job.
model JobAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  jobDayId  String
  userId    String
  jobDay    JobDay   @relation(fields: [jobDayId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobDayId, userId])
  @@index([jobDayId])
  @@index([userId])
}

model SavedJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Email {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  resendId  String       @unique
  to        String
  subject   String
  emailType String
  status    EmailStatus  @default(QUEUED)
  userId    String?
  clientId  String?
  events    EmailEvent[]

  @@index([resendId])
  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model EmailEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  eventType String
  payload   Json?
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([eventType])
  @@index([createdAt])
}

model EmailPreferences {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String?  @unique
  clientId         String?  @unique
  marketing        Boolean  @default(true)
  notifications    Boolean  @default(true)
  jobAlerts        Boolean  @default(true)
  quoteUpdates     Boolean  @default(true)
  unsubscribeToken String   @unique @default(cuid())

  @@index([unsubscribeToken])
}

model ScheduledEmail {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  jobId        String               @unique
  scheduledFor DateTime
  status       ScheduledEmailStatus @default(SCHEDULED)
  emailType    String
  recipientId  String
  subject      String
  metadata     Json?

  @@index([status])
  @@index([scheduledFor])
  @@index([recipientId])
}

model Availability {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  dateFrom  DateTime @db.Date
  dateTo    DateTime @db.Date
  notes     String?  @db.VarChar(200)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dateFrom, dateTo])
}

model JobInvite {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  jobId       String
  userId      String
  status      JobInviteStatus @default(PENDING)
  adminNote   String?         @db.VarChar(500)
  workerNote  String?         @db.VarChar(500)
  respondedAt DateTime?
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([status])
}

model BookingReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  bookingId String   @unique
  staffId   String
  clientId  String
  rating    Int
  comment   String?  @db.VarChar(1000)
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([staffId])
  @@index([clientId])
}

model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
