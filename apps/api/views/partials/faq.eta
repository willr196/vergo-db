<%/* A page's FAQs. items: [{ question, answer }]; answers are trusted HTML (they may carry links). name groups the <details> so one opens at a time. */%>
<% const items = it.items || []; items.forEach(function (f) { %>
        <details class="faq"<%~ it.name ? ' name="' + it.esc(it.name) + '"' : '' %>>
          <summary><%= f.question %></summary>
          <p><%~ f.answer %></p>
        </details>
<% }) %>
