{
  "name": "vergo-api",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/ensure-prisma-client-link.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/src/index.js",
    "smoke:browser": "npm run build && node scripts/browser-smoke.js",
    "pretest": "node scripts/ensure-prisma-client-link.js",
    "test": "npm run build && node --test dist/src/__tests__/*.test.js",
    "validate:pages": "node scripts/validate-page-consistency.js",
    "validate:seo": "node scripts/validate-seo.js",
    "prisma": "prisma",
    "prisma:deploy": "node scripts/prisma-deploy-with-retry.js",
    "prisma:deploy:raw": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "seed:jobs": "tsx prisma/seed-jobs.ts",
    "seed:marketplace": "tsx prisma/seed-marketplace.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^8.55.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.4",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.2",
    "file-type": "^21.3.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "prisma": "^6.19.3",
    "rate-limit-redis": "^4.3.1",
    "resend": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.7.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.2",
    "fast-xml-builder": "^1.2.0",
    "path-to-regexp": "0.1.13",
    "qs": "^6.15.2"
  }
}
