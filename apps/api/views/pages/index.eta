<%/* /: moved from public/index.html. Shared blocks and contact details come from it.blocks and it.t. No prices on this page. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Event Staff Hire in London & Birmingham | VERGO Staffing",
    "description": `Waiting staff, bar staff, kitchen porters, runners and hosts across London and Birmingham. Vetted, briefed and right-to-work checked.`,
    "ogImage": "/images/og/home.jpg",
    "canonical": "/"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "EmploymentAgency",
      "@id": "https://vergoltd.com/#organization",
      "name": "VERGO Staffing",
      "legalName": `${it.t.LEGAL_NAME}`,
      "url": "https://vergoltd.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://vergoltd.com/images/vergo-mark.jpg"
      },
      "image": "https://vergoltd.com/images/og/home.jpg",
      "description": "Event and hospitality staffing across London and Birmingham: waiting staff, bar staff, kitchen porters, runners, hosts and front of house.",
      "telephone": `${it.t.PHONE_E164}`,
      "address": it.postalAddress(it.t.REGISTERED_OFFICE),
      "email": `${it.t.EMAIL}`,
      "areaServed": [
        { "@type": "City", "name": "London" },
        { "@type": "City", "name": "Birmingham" }
      ],
      "sameAs": [
        `${it.t.INSTAGRAM_URL}`,
        "https://maps.google.com/?cid=13724807393397816489"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://vergoltd.com/#website",
      "url": "https://vergoltd.com",
      "name": "VERGO Staffing",
      "publisher": {
        "@id": "https://vergoltd.com/#organization"
      },
      "inLanguage": "en-GB"
    }
  ]
}) %>
    <div class="home-hero-band">
    <section class="home-hero shell">
      <div class="home-hero-head">
        <img class="home-logo" src="/images/vergo-mark-400.webp" width="600" height="600" alt="" fetchpriority="high">
        <div class="home-hero-centre">
          <h1>Event Staff</h1>
          <%~ include('/partials/city-switch', { current: "london" }) %>
          <p class="home-slogan"><%~ it.t.SLOGAN %></p>
        </div>
        <a class="home-halloween" href="/special-events/halloween">
          <img src="/images/special-events/vergo-pumpkin.svg" width="420" height="420" alt="">
          <span>Halloween staff</span>
        </a>
      </div>
    </section>
    </div>

    <!-- The three ways in. Hire staff is the centrepiece: first in the markup
         (so first on phones), centred and largest from 860px. -->
    <nav class="section-tight shell path-banners" aria-label="Where to start">
      <a class="path-banner path-banner--main" href="/hire">
        <span class="path-kicker">Most booked</span>
        <h2 class="path-title">Hire staff for your event</h2>
        <p class="path-line">Waiting, bar, kitchen porters, hosts, cleaners and security across London and Birmingham. <%= it.t.ROSTER_LINE %></p>
        <span class="path-go">Hire staff &rarr;</span>
      </a>
      <a class="path-banner" href="/work">
        <span class="path-kicker">Work with us</span>
        <h2 class="path-title">Apply for work</h2>
        <p class="path-line">Waiting, bar and kitchen shifts in London. Now hiring in Birmingham.</p>
        <span class="path-go">Apply &rarr;</span>
      </a>
      <a class="path-banner" href="/book-an-event">
        <span class="path-kicker">Full events</span>
        <h2 class="path-title">Book an event</h2>
        <p class="path-line">Food, bar and staff from one company.</p>
        <span class="path-go">Book an event &rarr;</span>
      </a>
    </nav>

    <section class="home-cta shell">
      <p class="lede">Vetted, briefed staff for events across London and Birmingham.</p>
      <div class="btn-row">
        <a href="/hire" class="btn btn-primary">Hire staff</a>
        <a href="/hire/quote" class="btn btn-secondary">Get a quote</a>
      </div>
      <p class="home-today">Need someone today? <a href="<%~ it.t.PHONE_TEL %>">Call <%~ it.t.PHONE %></a> or <a href="<%~ it.t.WHATSAPP_URL %>" data-whatsapp target="_blank" rel="noopener">WhatsApp us</a>.</p>
    </section>

    <%~ it.blocks["trust-strip"]() %>

    <!-- The season in the header right now, chosen on the server from the
         stored promos (admin: Site content > Seasonal promos): Halloween to
         31 October, then Christmas to 20 December. Nothing outside a season. -->
    <%~ it.blocks["season-feature"]() %>

    <%~ it.blocks["testimonials"]({ "featured": "1" }) %>
