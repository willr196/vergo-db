<%/* /hire/waiting-staff: moved from public/hire/waiting-staff.html. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Waiting Staff Hire in London | VERGO Staffing",
    "description": `Waiting staff hire in London for receptions, canapés and seated dinners. ${it.t.HEADLINE_RATE} per person, four-hour minimum, names confirmed the same day.`,
    "ogImage": "/images/og/waiting-staff.jpg",
    "canonical": "/hire/waiting-staff"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Waiting staff hire",
      "serviceType": "Event and hospitality staffing",
      "url": "https://vergoltd.com/hire/waiting-staff",
      "description": "Waiting staff for drinks receptions, canapé service, seated dinners and clearing down at events across London.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      },
      "offers": {
        "@type": "Offer",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": Number(it.t.STANDARD_RATE_NUMBER),
          "priceCurrency": "GBP",
          "unitCode": "HUR",
          "unitText": "per hour, per person",
          "referenceQuantity": {
            "@type": "QuantitativeValue",
            "value": Number(it.t.MIN_HOURS),
            "unitCode": "HUR"
          }
        }
      }
    },
    it.faqJsonLd("hire/waiting-staff")
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Waiting staff</span>
      <h1>Waiting staff hire in London</h1>
      <p class="lede">For receptions, canapés, seated dinners and the clear down, briefed on your running order.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <section class="section shell" aria-labelledby="whattheydo-heading">
      <h2 id="whattheydo-heading" class="section-label">What they do</h2>
      <ul class="check-list">
        <li>Trays out on time, drinks topped up</li>
        <li>Plated, silver or sharing service, courses together</li>
        <li>Tables cleared, room put back as found</li>
      </ul>
      <p class="section-note">On a staff booking we supply people only: glassware, crockery and linen stay with you or your caterer. For food and bar too, see <a href="/book-an-event">full events</a>.</p>
    </section>

    <%~ it.blocks["rates"]() %>

    <%~ it.blocks["guarantees"]() %>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="section-label">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("hire/waiting-staff"), name: "waiting-staff-faq", esc: it.esc }) %>
      </div>
      <p class="link-row">Also: <a href="/hire/bar-staff">Bar staff</a> · <a href="/hire/kitchen-porters">Kitchen porters</a> · <a href="/hire/weddings">Weddings</a></p>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Got a date in the diary?" }) %>
