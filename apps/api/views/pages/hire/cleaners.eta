<%/* /hire/cleaners: event cleaning staff. Quoted on the brief, so no rate block and no price in the structured data. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Event Cleaners for Hire in London | VERGO Staffing",
    "description": "Event cleaners in London for set-up, during service and the clean-down after. Quoted on the brief, names confirmed the same day.",
    "ogImage": "/images/og/hire.jpg",
    "canonical": "/hire/cleaners"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Event cleaner hire",
      "serviceType": "Event cleaning staff",
      "url": "https://vergoltd.com/hire/cleaners",
      "description": "Cleaners for events, venues and parties across London: pre-event clean, toilets and floors during service, and the full clean-down after.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      }
    },
    it.faqJsonLd("hire/cleaners")
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Event cleaners</span>
      <h1>Event cleaners for hire in London</h1>
      <p class="lede">Before the doors open, through the night, and after the last guest leaves.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <section class="section shell" aria-labelledby="whattheydo-heading">
      <h2 id="whattheydo-heading" class="section-label">What they do</h2>
      <ul class="check-list">
        <li><strong>Before:</strong> venue cleaned and ready, surfaces, floors and toilets</li>
        <li><strong>During:</strong> toilets checked and stocked, spills, bins and floors kept on top of</li>
        <li><strong>After:</strong> full clean-down, rubbish and recycling out, venue handed back</li>
      </ul>
      <p class="section-note"><%= it.t.ROSTER_LINE %> Priced on the brief.</p>
    </section>

    <%~ it.blocks["guarantees"]() %>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="section-label">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("hire/cleaners"), name: "cleaners-faq", esc: it.esc }) %>
      </div>
      <p class="link-row">Also: <a href="/hire/security">Event security</a> · <a href="/hire/kitchen-porters">Kitchen porters</a> · <a href="/hire/corporate-events">Corporate and large events</a></p>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Need the venue spotless?" }) %>
