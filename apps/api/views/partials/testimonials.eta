<%/* featured is the homepage cut: the one review marked "show on home". Otherwise every review marked "show on /hire". */%>
<% const list = it.attrs.featured
  ? it.proof.testimonials.filter(function (t) { return t.showOnHome; }).slice(0, 1)
  : it.proof.testimonials.filter(function (t) { return t.showOnHire; }); %>
<% if (list.length) { %>
<section class="section shell" aria-labelledby="testimonials-heading">
      <h2 id="testimonials-heading" class="section-label">What clients say</h2>
      <div class="testimonials">
<% list.forEach(function (t) { %>
        <%~ include('/partials/testimonial', { t: t }) %>
<% }) %>
      </div>
<% if (it.site.googleReviewsUrl) { %>
      <a class="testimonials-more" href="<%= it.site.googleReviewsUrl %>" target="_blank" rel="noopener">Read our Google reviews &rarr;</a>
<% } %>
    </section>
<% } %>
