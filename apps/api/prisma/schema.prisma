  /// Client, Staff, Job, Assignment, Lead or JobScheduleItem.
  entity    String   @db.VarChar(40)
  legacyId  String   @db.VarChar(40)
  newId     String   @db.VarChar(40)

  @@unique([entity, legacyId])
}

/// Business-client Terms of Business as issued to one hirer: the exact text
/// (renderedBody) of the version issued, and the acceptance recorded against
/// it. Never edited after acceptance; a newer issue supersedes it.
model ClientDocument {
  id                   String               @id @default(cuid())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  clientId             String
  templateId           String
  version              Int
  status               WorkerDocumentStatus @default(ISSUED)
  issuedAt             DateTime             @default(now())
  issuedBy             String               @db.VarChar(100)
  renderedBody         String
  bodySha256           String               @db.VarChar(64)
  acceptedAt           DateTime?
  legalBusinessName    String?              @db.VarChar(200)
  acceptedByName       String?              @db.VarChar(200)
  acceptedByJobTitle   String?              @db.VarChar(120)
  typedName            String?              @db.VarChar(200)
  /// e.g. "Electronic acceptance via secure link", or how an admin received it.
  acceptanceMethod     String?              @db.VarChar(200)
  acceptanceStatement  String?              @db.VarChar(500)
  /// The admin who recorded an acceptance received outside the link, if any.
  acceptanceRecordedBy String?              @db.VarChar(100)
  acceptedViaLinkId    String?              @db.VarChar(40)
  acceptanceIp         String?              @db.VarChar(64)
  acceptanceUserAgent  String?              @db.VarChar(300)
  supersededAt         DateTime?
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template             DocumentTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([templateId])
}

/// A secure link that opens one worker's documents or one client's Terms.
/// Only the SHA-256 of the token is stored; the token is shown once.
model DocumentLink {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  kind         DocumentLinkKind
  tokenHash    String           @unique @db.VarChar(64)
  userId       String?
  clientId     String?
  createdBy    String           @db.VarChar(100)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastOpenedAt DateTime?
  emailedAt    DateTime?
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

// ============================================================================
// VERGO Scheduling
//
// The desktop admin tool (Documents/vergo_admin) on the web, with its exact
// structure: clients, one-day jobs, people, the crew on each job, running
// orders and outreach. Its own tables, deliberately separate from VERGO Ops:
// nothing here is a worker account, an Ops booking or a payroll record.
// Field names match the desktop tool's, so its backups restore row for row
// (ids included). See src/scheduling/ and docs/VERGO-SCHEDULING.md.
// ============================================================================

model SchedClient {
  id                String     @id @default(cuid())
  name              String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  /// Pre-fills Job.chargeRate when you create a job for this client.
  defaultChargeRate Decimal?   @db.Decimal(10, 2)
  notes             String?
  archived          Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  jobs              SchedJob[]
  /// The outreach that won this client, if it came from one.
  lead              SchedLead?

  @@index([archived, name])
  @@map("sched_client")
}

/// One job on one day. A job running three days is three jobs sharing a seriesId.
model SchedJob {
  id            String                 @id @default(cuid())
  /// VJ-0042.
  reference     String                 @unique
  clientId      String?
  client        SchedClient?           @relation(fields: [clientId], references: [id])
  title         String
  venueName     String?
  date          DateTime               @db.Date
  /// 24-hour HH:MM. endTime <= startTime means it runs past midnight.
  startTime     String
  endTime       String
  breakMinutes  Int                    @default(0)
  /// Last day of a run; null on a one-day job.
  endDate       DateTime?              @db.Date
  ongoing       Boolean                @default(false)
  /// 1=Monday to 7=Sunday. Empty means every day.
  repeatDays    Int[]
  seriesId      String?
  staffNeeded   Int?
  roleNeeded    String?
  /// Per hour, ex VAT. What you charge the client.
  chargeRate    Decimal                @db.Decimal(10, 2)
  status        SchedJobStatus         @default(CONFIRMED)
  invoiceStatus SchedInvoiceStatus     @default(NOT_INVOICED)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  assignments   SchedAssignment[]
  scheduleItems SchedJobScheduleItem[]

  @@index([date])
  @@index([clientId, date])
  @@index([status, date])
  @@index([invoiceStatus, status, date])
  @@index([seriesId, date])
  @@map("sched_job")
}

enum SchedJobStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SchedInvoiceStatus {
  NOT_INVOICED
  INVOICED
  PAID
}

/// A person who can be put on a job. Not a payroll record and not a worker account.
model SchedStaff {
  id          String            @id @default(cuid())
  firstName   String
  lastName    String
  email       String?           @unique
  phone       String?
  /// Base rate for costing; holiday pay is added on top. No default: no rate, no assignment.
  hourlyRate  Decimal?          @db.Decimal(10, 2)
  status      SchedStaffStatus  @default(ACTIVE)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignments SchedAssignment[]

  @@index([status, lastName])
  @@map("sched_staff")
}

enum SchedStaffStatus {
  ACTIVE
  INACTIVE
}

/// A person on a job.
model SchedAssignment {
  id           String     @id @default(cuid())
  jobId        String
  job          SchedJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  staffId      String
  staff        SchedStaff @relation(fields: [staffId], references: [id])
  hours        Decimal    @db.Decimal(5, 2)
  rateOverride Decimal?   @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([jobId, staffId])
  @@index([staffId])
  @@map("sched_assignment")
}

/// One line on a job's running order. Not a shift: editing it never changes hours.
model SchedJobScheduleItem {
  id        String   @id @default(cuid())
  jobId     String
  job       SchedJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  time      String?
  title     String
  assignee  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, time])
  @@map("sched_job_schedule_item")
}

/// A company approached for work, before it is a client.
model SchedLead {
  id           String           @id @default(cuid())
  company      String
  contactName  String?
  contactEmail String?
  contactPhone String?
  contactedOn  DateTime         @db.Date
  channel      SchedLeadChannel @default(EMAIL)
  stage        SchedLeadStage   @default(CONTACTED)
  notes        String?
  clientId     String?          @unique
  client       SchedClient?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([stage, contactedOn])
  @@map("sched_lead")
}

enum SchedLeadChannel {
  EMAIL
  PHONE
  IN_PERSON
  OTHER
}

enum SchedLeadStage {
  CONTACTED
  REPLIED
  WON
  LOST
}
