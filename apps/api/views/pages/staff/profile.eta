<%/* /staff/profile: a signed-in worker's photo, details, roles, emergency
     contact and password. A static shell; staff-account.js checks the session
     and fills it from /api/v1/user/profile, or sends them to /staff/login. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Your Profile | VERGO Staffing",
    "description": "Your VERGO staff profile.",
    "ogImage": "/images/og/work.jpg",
    "robots": "noindex",
    "canonical": "/staff/profile"
  },
  scripts: ["/pages/js/staff-common.js", "/pages/js/staff-account.js"],
  header: {"focused":"1","back":"/work","label":"← Back to work with us"}
}) %>
    <%~ include('/partials/staff-nav', { current: 'profile' }) %>
    <section class="page-hero-plain shell-form">
      <span class="eyebrow">Staff</span>
      <h1 id="accountHeading">Your profile</h1>
      <p class="lede" id="accountLede">Loading your details…</p>
    </section>

    <section class="section-tight shell-form" id="accountBody" hidden>
      <div id="photoSection">
        <h2>Your photo <span class="label-note">required</span></h2>
        <p class="form-hint form-hint-block">A clear photo of your face, on your own. Clients see it when we send you to them.</p>
        <div class="staff-photo">
          <img id="photoPreview" alt="Your profile photo" hidden>
          <div class="staff-photo-blank" id="photoBlank">No photo yet</div>
          <div>
            <label class="btn btn-secondary" for="photoInput" id="photoButton">Choose a photo</label>
            <input type="file" id="photoInput" accept="image/jpeg,image/png,image/webp" class="sr-only">
          </div>
        </div>
        <div class="form-status" id="photoStatus" role="status" hidden></div>
      </div>

      <form id="profileForm" class="staff-section" novalidate>
        <h2>Your details</h2>
        <div class="form-row form-row-2">
          <div class="form-field">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" name="firstName" autocomplete="given-name" maxlength="100" required>
          </div>
          <div class="form-field">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" name="lastName" autocomplete="family-name" maxlength="100" required>
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-field">
            <label for="accountEmail">Email address</label>
            <input type="email" id="accountEmail" readonly aria-describedby="emailHint">
            <p class="form-hint" id="emailHint">You sign in with this. To change it, get in touch.</p>
          </div>
          <div class="form-field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="20">
          </div>
        </div>
        <div class="form-field">
          <label for="postcode">Home postcode <span class="label-note">helps us offer you nearby work</span></label>
          <input type="text" id="postcode" name="postcode" autocomplete="postal-code" maxlength="24">
        </div>

        <fieldset class="form-field" id="rolesSection" aria-describedby="rolesHint" hidden>
          <legend>Roles you work</legend>
          <p class="form-hint" id="rolesHint">Ticked from your application. Change them if you want to be offered different work.</p>
          <div class="staff-choices" id="roles"></div>
        </fieldset>
        <div class="form-field" id="availabilityField" hidden>
          <label for="availability">When you can work</label>
          <input type="text" id="availability" name="availability" maxlength="1000" placeholder="e.g. weekends and weekday evenings">
        </div>
        <div class="form-field">
          <label for="experienceSummary">Your experience <span class="label-note">optional</span></label>
          <textarea id="experienceSummary" name="experienceSummary" maxlength="500" placeholder="Where you have worked, what you are good at"></textarea>
        </div>

        <div id="emergencySection" hidden>
          <h2>In an emergency</h2>
          <p class="form-hint form-hint-block">Who we call if something happens to you on a shift.</p>
          <div class="form-row form-row-2">
            <div class="form-field">
              <label for="emergencyContactName">Their name</label>
              <input type="text" id="emergencyContactName" name="emergencyContactName" maxlength="120">
            </div>
            <div class="form-field">
              <label for="emergencyContactPhone">Their phone</label>
              <input type="tel" id="emergencyContactPhone" name="emergencyContactPhone" maxlength="40">
            </div>
          </div>
        </div>

        <div class="form-status" id="profileStatus" role="status" hidden></div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-block" id="profileSave">Save my details</button>
        </div>
      </form>

      <form id="passwordForm" class="staff-section" novalidate>
        <h2>Password</h2>
        <input type="text" name="username" id="passwordUsername" autocomplete="username" hidden>
        <div class="form-field">
          <label for="currentPassword">Current password</label>
          <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" maxlength="72" required>
        </div>
        <div class="form-row form-row-2">
          <div class="form-field">
            <label for="newPassword">New password</label>
            <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" minlength="8" maxlength="72" required>
          </div>
          <div class="form-field">
            <label for="confirmPassword">Type it again</label>
            <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" minlength="8" maxlength="72" required>
          </div>
        </div>
        <div class="form-status" id="passwordStatus" role="status" hidden></div>
        <div class="form-actions">
          <button type="submit" class="btn btn-secondary btn-block">Change password</button>
        </div>
      </form>
    </section>
