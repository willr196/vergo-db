generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Applicant {
  id                String        @id @default(cuid())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  firstName         String
  lastName          String
  email             String        @unique
  phone             String?
  rightToWorkUk     Boolean?
  averageRating     Decimal?      @db.Decimal(3, 2)
  bio               String?
  dateOfBirth       DateTime?
  hourlyRate        Decimal?      @db.Decimal(10, 2)
  postcode          String?
  preferredJobTypes String?
  profileVisible    Boolean       @default(false)
  promotedToGoldAt  DateTime?
  staffTier         String        @default("STANDARD")
  totalBookings     Int           @default(0)
  yearsExperience   Int?
  applications      Application[]
  user              User?
}

model Role {
  id           String            @id @default(cuid())
  name         String            @unique
  applications ApplicationRole[]
  jobs         Job[]
}

model ApplicationRole {
  applicationId   String
  roleId          String
  experienceLevel String?
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role            Role        @relation(fields: [roleId], references: [id])

  @@id([applicationId, roleId])
  @@map("ApplicationRole")
}

model Application {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  status         ApplicationStatus @default(RECEIVED)
  cvKey          String
  source         String?
  applicantId    String
  cvOriginalName String?
  notes          String?
  updatedAt      DateTime          @updatedAt
  cvFileSize     Int?
  cvMimeType     String?
  cvUploadedAt   DateTime?
  applicant      Applicant         @relation(fields: [applicantId], references: [id])
  roles          ApplicationRole[]

  @@index([status, createdAt])
}

model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  password       String
  createdAt      DateTime  @default(now())
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  @@index([username])
}

model Client {
  id                    String             @id @default(cuid())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  companyName           String
  industry              String?
  website               String?
  vatNumber             String?
  companySize           String?
  contactName           String
  email                 String             @unique
  passwordHash          String
  phone                 String?
  jobTitle              String?
  status                ClientStatus       @default(PENDING)
  approvedAt            DateTime?
  approvedBy            String?
  rejectionReason       String?
  emailVerified         Boolean            @default(false)
  verifyToken           String?
  verifyTokenExp        DateTime?
  resetToken            String?
  resetTokenExp         DateTime?
  failedAttempts        Int                @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  adminNotes            String?
  subscriptionTier      SubscriptionTier   @default(STANDARD)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  logo                  String?
  postcode              String?
  seqId                 Int                @unique @default(autoincrement())
  bookings              Booking[]
  jobs                  Job[]
  pushTokens            PushToken[]
  quoteRequests         QuoteRequest[]
  refreshTokens         RefreshToken[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  eventType     String
  eventDate     DateTime?
  eventEndDate  DateTime?
  location      String
  venue         String?
  staffCount    Int
  roles         String
  shiftStart    String?
  shiftEnd      String?
  description   String?
  budget        String?
  status        String       @default("NEW")
  adminNotes    String?
  quotedAmount  Decimal?     @db.Decimal(10, 2)
  quoteSentAt   DateTime?
  clientId      String
  requestedLane BookingLane?
  bookings      Booking[]
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([requestedLane])
}

model PricingTier {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  clientTier   SubscriptionTier
  staffTier    StaffTier
  hourlyRate   Decimal          @db.Decimal(10, 2)
  staffPayRate Decimal?         @db.Decimal(10, 2)
  isBookable   Boolean          @default(true)

  @@unique([clientTier, staffTier])
  @@map("PricingTier")
}

model SubscriptionPlan {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tier         SubscriptionTier @unique
  name         String
  weeklyPrice  Decimal          @db.Decimal(10, 2)
  monthlyPrice Decimal?         @db.Decimal(10, 2)
  annualPrice  Decimal?         @db.Decimal(10, 2)
  features     String?
  isActive     Boolean          @default(true)

  @@map("SubscriptionPlan")
}

model Booking {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  status              BookingStatus    @default(PENDING)
  eventName           String?
  eventDate           DateTime
  eventEndDate        DateTime?
  location            String
  venue               String?
  shiftStart          String
  shiftEnd            String
  hoursEstimated      Decimal?         @db.Decimal(5, 2)
  clientTierAtBooking SubscriptionTier
  staffTierAtBooking  StaffTier
  hourlyRateCharged   Decimal          @db.Decimal(10, 2)
  staffPayRate        Decimal?         @db.Decimal(10, 2)
  totalEstimated      Decimal?         @db.Decimal(10, 2)
  clientNotes         String?
  adminNotes          String?
  rejectionReason     String?
  confirmedAt         DateTime?
  confirmedBy         String?
  completedAt         DateTime?
  clientId            String
  staffId             String
  quoteRequestId      String?
  bookingLane         BookingLane      @default(FLEX)
  client              Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteRequest        QuoteRequest?    @relation(fields: [quoteRequestId], references: [id])
  staff               User             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  review              BookingReview?

  @@index([clientId])
  @@index([staffId])
  @@index([status])
  @@index([bookingLane])
  @@index([eventDate])
  @@index([createdAt])
}

model Contact {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  name       String
  email      String
  phone      String?
  company    String?
  type       ContactType
  eventType  String?
  eventDate  DateTime?
  guests     Int?
  staffCount Int?
  roles      String?
  subject    String?
  message    String
  status     ContactStatus @default(NEW)
  adminNotes String?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model FileUploadVerification {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(500)
  applicantId String   @db.VarChar(36)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  verified    Boolean  @default(false)

  @@index([key])
  @@index([expiresAt])
}

model User {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  email               String           @unique
  passwordHash        String
  emailVerified       Boolean          @default(false)
  verifyToken         String?
  resetToken          String?
  resetTokenExp       DateTime?
  firstName           String
  lastName            String
  phone               String?
  applicantId         String?          @unique
  failedAttempts      Int              @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  approvedClient      Boolean          @default(false)
  billingAddress      String?
  companyName         String?
  companyWebsite      String?
  userType            UserType         @default(JOB_SEEKER)
  vatNumber           String?
  verifyTokenExp      DateTime?
  staffTier           StaffTier?
  staffBio            String?
  staffAvatar         String?
  staffAvailable      Boolean          @default(false)
  staffRating         Decimal?         @db.Decimal(3, 2)
  staffReviewCount    Int              @default(0)
  staffHighlights     String?
  shortlistSelections Int              @default(0)
  seqId               Int              @unique @default(autoincrement())
  mustChangePassword  Boolean          @default(false)
  bookings            Booking[]
  jobApplications     JobApplication[]
  pushTokens          PushToken[]
  refreshTokens       RefreshToken[]
  savedJobs           SavedJob[]
  availability        Availability[]
  jobInvites          JobInvite[]
  applicant           Applicant?       @relation(fields: [applicantId], references: [id])

  @@index([email])
  @@index([userType])
}

model RefreshToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  tokenHash String    @unique
  userId    String?
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
}

model PushToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique
  platform  String
  userId    String?
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

model Job {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  title               String
  description         String
  location            String
  roleId              String
  status              JobStatus        @default(DRAFT)
  closingDate         DateTime?
  companyName         String?
  eventDate           DateTime?
  eventEndDate        DateTime?
  externalUrl         String?
  payRate             Decimal?         @db.Decimal(10, 2)
  payType             PayType          @default(HOURLY)
  publishedAt         DateTime?
  requirements        String?
  shiftEnd            String?
  shiftStart          String?
  staffConfirmed      Int              @default(0)
  staffNeeded         Int              @default(1)
  type                JobType          @default(INTERNAL)
  venue               String?
  clientId            String?
  tier                JobTier          @default(STANDARD)
  shortlistReviewedAt DateTime?
  posterEmail         String?
  client              Client?          @relation(fields: [clientId], references: [id])
  role                Role             @relation(fields: [roleId], references: [id])
  applications        JobApplication[]
  savedBy             SavedJob[]
  invites             JobInvite[]

  @@index([status, type])
  @@index([clientId])
  @@index([roleId])
  @@index([eventDate])
  @@index([publishedAt])
}

model JobApplication {
  id         String               @id @default(cuid())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  jobId      String
  status     JobApplicationStatus @default(PENDING)
  adminNotes String?
  coverNote  String?
  userId     String
  rateUplift Decimal?             @db.Decimal(10, 2)
  job        Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([status])
  @@index([createdAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Email {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  resendId  String       @unique
  to        String
  subject   String
  emailType String
  status    EmailStatus  @default(QUEUED)
  userId    String?
  clientId  String?
  events    EmailEvent[]

  @@index([resendId])
  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model EmailEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  eventType String
  payload   Json?
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([eventType])
  @@index([createdAt])
}

model EmailPreferences {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String?  @unique
  clientId         String?  @unique
  marketing        Boolean  @default(true)
  notifications    Boolean  @default(true)
  jobAlerts        Boolean  @default(true)
  quoteUpdates     Boolean  @default(true)
  unsubscribeToken String   @unique @default(cuid())

  @@index([unsubscribeToken])
}

model ScheduledEmail {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  jobId        String               @unique
  scheduledFor DateTime
  status       ScheduledEmailStatus @default(SCHEDULED)
  emailType    String
  recipientId  String
  subject      String
  metadata     Json?

  @@index([status])
  @@index([scheduledFor])
  @@index([recipientId])
}

model Availability {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  dateFrom  DateTime @db.Date
  dateTo    DateTime @db.Date
  notes     String?  @db.VarChar(200)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dateFrom, dateTo])
}

model JobInvite {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  jobId       String
  userId      String
  status      JobInviteStatus @default(PENDING)
  adminNote   String?         @db.VarChar(500)
  workerNote  String?         @db.VarChar(500)
  respondedAt DateTime?
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([status])
}

model BookingReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  bookingId String   @unique
  staffId   String
  clientId  String
  rating    Int
  comment   String?  @db.VarChar(1000)
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([staffId])
  @@index([clientId])
}

model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

enum ContactType {
  STAFF_REQUEST
  GENERAL
}

enum ContactStatus {
  NEW
  CONTACTED
  QUOTED
  BOOKED
  LOST
}

enum ClientStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionTier {
  STANDARD
  PREMIUM
}

enum StaffTier {
  STANDARD
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingLane {
  FLEX
  SELECT
  MANAGED
}

enum JobType {
  INTERNAL
  EXTERNAL
}

enum JobTier {
  STANDARD
  SHORTLIST
  GOLD
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
  PENDING
}

enum PayType {
  HOURLY
  DAILY
  FIXED
}

enum JobApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  CONFIRMED
  REJECTED
  WITHDRAWN
}

enum UserType {
  JOB_SEEKER
  CLIENT
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

enum ScheduledEmailStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum JobInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}
