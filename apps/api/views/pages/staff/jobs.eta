<%/* /staff/jobs: the job board for signed-in staff, with Apply. Jobs come
     from /api/v1/jobs. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Job Board | VERGO Staffing",
    "description": "Open jobs for VERGO staff.",
    "ogImage": "/images/og/work.jpg",
    "robots": "noindex",
    "canonical": "/staff/jobs"
  },
  scripts: ["/pages/js/staff-common.js", "/pages/js/staff-jobs.js"],
  header: {"focused":"1","back":"/work","label":"← Back to work with us"}
}) %>
    <%~ include('/partials/staff-nav', { current: 'jobs' }) %>
    <section class="page-hero-plain shell-form">
      <span class="eyebrow">Staff</span>
      <h1>Job board</h1>
      <p class="lede">Open jobs. Apply and we confirm with you before you are booked.</p>
    </section>

    <section class="section-tight shell-form">
      <div class="form-status" id="jobsStatus" role="status" hidden></div>
      <form class="staff-filters" id="jobFilters" role="search" novalidate>
        <div class="staff-filter staff-filter-wide">
          <label for="jobSearch">Search</label>
          <input type="search" id="jobSearch" placeholder="Venue, area or job" autocomplete="off">
        </div>
        <div class="staff-filter">
          <label for="jobRole">Role</label>
          <select id="jobRole"><option value="">Any role</option></select>
        </div>
        <div class="staff-filter">
          <label for="jobWhen">When</label>
          <select id="jobWhen">
            <option value="">Any time</option>
            <option value="week">Next 7 days</option>
            <option value="month">Next 30 days</option>
            <option value="weekend">Fridays to Sundays</option>
          </select>
        </div>
        <div class="staff-filter">
          <label for="jobSort">Sort</label>
          <select id="jobSort">
            <option value="soon">Soonest first</option>
            <option value="pay">Best paid first</option>
            <option value="new">Newest first</option>
          </select>
        </div>
        <label class="checkbox-line staff-filter-check" for="jobHideApplied">
          <input type="checkbox" id="jobHideApplied"><span>Hide jobs I've applied for</span>
        </label>
        <label class="checkbox-line staff-filter-check" for="jobSavedOnly">
          <input type="checkbox" id="jobSavedOnly"><span>Only jobs I've saved</span>
        </label>
      </form>
      <p class="staff-count" id="jobCount" aria-live="polite"></p>
      <ul class="staff-list" id="jobList" aria-live="polite"></ul>
      <p class="staff-empty" id="jobsEmpty" hidden>No open jobs right now. We will email you when something comes up.</p>
    </section>
