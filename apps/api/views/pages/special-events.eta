<%/* /special-events, "Seasonal" in the header: one banner per season, then the general brief. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Christmas & New Year's Eve Staff | VERGO Staffing",
    "description": "Christmas party and New Year's Eve staff in London and Birmingham: bar, waiting and kitchen teams for the season.",
    "ogImage": "/images/og/special-events.jpg",
    "canonical": "/special-events"
  },
  styles: ["/pages/css/special-events.css"],
  scripts: ["/pages/js/special-events-brief.js"],
  bodyClass: "se-page se-theme-light",
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://vergoltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seasonal",
          "item": "https://vergoltd.com/special-events"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Seasonal event staffing",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Christmas party staffing",
          "url": "https://vergoltd.com/special-events/christmas"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "New Year's Eve staffing",
          "url": "https://vergoltd.com/special-events/new-years-eve"
        }
      ]
    }
  ]
}) %>
<% const tag = function (s) { return s.inSeason ? 'Now booking' : 'Now booking ' + s.label + ' ' + s.year; }; %>
<% const xmas = it.eventSeason('christmas', 'Christmas'); const nye = it.eventSeason('new-years-eve', 'New Year’s Eve'); %>

    <section class="page-hero-plain shell">
      <span class="eyebrow">Seasonal</span>
      <h1>Christmas and New Year&rsquo;s Eve</h1>
      <p class="lede">Staff for the busiest weeks of the year, in London and Birmingham.</p>
    </section>

    <section class="section shell" aria-label="This season">
      <div class="se-season-banners">
        <a class="se-season-banner" href="/special-events/christmas">
          <div>
            <span class="se-season-banner-tag"><%= tag(xmas) %></span>
            <h3>Christmas</h3>
            <p>Bar, waiting and kitchen staff for your Christmas party, straight or themed.</p>
            <span class="se-season-banner-cta">Plan your party &rarr;</span>
          </div>
          <span class="se-season-banner-art" aria-hidden="true"></span>
        </a>
        <a class="se-season-banner se-season-banner--nye" href="/special-events/new-years-eve">
          <div>
            <span class="se-season-banner-tag"><%= tag(nye) %></span>
            <h3>New Year&rsquo;s Eve</h3>
            <p>Teams to see the year out, from black tie to masquerade.</p>
            <span class="se-season-banner-cta">Plan your night &rarr;</span>
          </div>
          <span class="se-season-banner-art" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <!-- ================================================================
         General brief. Posts to the quote endpoint as an ENQUIRY, tagged
         with the concept picked. Same script as the Christmas form:
         /pages/js/special-events-brief.js.
         ================================================================ -->
    <div class="se-form-section">
      <section class="section se-form-shell" id="brief" aria-labelledby="brief-heading">
        <div class="se-form-head">
          <p class="section-label">Enquiry</p>
          <h2 id="brief-heading">Send us the brief</h2>
          <p>Nothing here is binding. We come back with a suggested team.</p>
        </div>

        <form id="specialEventsForm" novalidate data-se-brief data-event-type="Seasonal (Special Events)" data-brief-label="Seasonal brief">
          <div class="hp-field" aria-hidden="true">
            <label for="sebWebsite">Website</label>
            <input type="text" id="sebWebsite" name="website" tabindex="-1" autocomplete="off">
          </div>

          <fieldset class="se-fieldset">
            <legend>Which season?</legend>
            <div class="se-pillset">
              <label class="se-pill"><input type="radio" name="concept" value="Christmas"><span>Christmas</span></label>
              <label class="se-pill"><input type="radio" name="concept" value="New Year&#39;s Eve"><span>New Year&rsquo;s Eve</span></label>
              <label class="se-pill"><input type="radio" name="concept" value="Something else"><span>Something else</span></label>
            </div>
          </fieldset>

          <fieldset class="se-fieldset">
            <legend>Your event</legend>
            <p class="form-hint">Leave anything blank.</p>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="sebName">Name</label>
                <input type="text" id="sebName" name="name" autocomplete="name">
              </div>
              <div class="form-field">
                <label for="sebCompany">Company <span class="label-note">optional</span></label>
                <input type="text" id="sebCompany" name="company" autocomplete="organization">
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="sebEmail">Email</label>
                <input type="email" id="sebEmail" name="email" autocomplete="email">
              </div>
              <div class="form-field">
                <label for="sebPhone">Phone</label>
                <input type="tel" id="sebPhone" name="phone" autocomplete="tel">
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="sebDate">Date</label>
                <input type="date" id="sebDate" name="eventDate">
              </div>
              <div class="form-field">
                <label for="sebLocation">Location</label>
                <input type="text" id="sebLocation" name="location" autocomplete="address-level2" placeholder="e.g. Shoreditch, E1">
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="sebGuests">Guests</label>
                <input type="number" id="sebGuests" name="guestCount" min="1" max="100000" step="1" inputmode="numeric" placeholder="e.g. 150">
              </div>
              <div class="form-field">
                <label for="sebHours">Hours</label>
                <input type="number" id="sebHours" name="hours" min="1" max="24" step="1" inputmode="numeric" placeholder="e.g. 5">
              </div>
            </div>

            <div class="form-field">
              <label for="sebMessage">The event <span class="label-note">optional</span></label>
              <textarea id="sebMessage" name="message" maxlength="2000" placeholder="Venue, idea, anything you are unsure about."></textarea>
            </div>
          </fieldset>

          <div class="se-form-actions">
            <button type="submit" class="btn btn-primary btn-block">Send us the brief</button>
            <p class="se-form-reassure">Not sure what you need? Send the event and we&rsquo;ll recommend a team.</p>
          </div>

          <div class="form-status" role="status" hidden></div>
        </form>
      </section>
    </div>
