<%/* /hire/private-parties: staff for birthdays, anniversaries and parties at home. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Private Party Staff Hire in London | VERGO Staffing",
    "description": `Private party staff in London for birthdays, anniversaries and parties at home. Waiting and bar staff, ${it.t.HEADLINE_RATE_LOWER} per person.`,
    "ogImage": "/images/og/bar-staff.jpg",
    "canonical": "/hire/private-parties"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Private party staff hire",
      "serviceType": "Event and hospitality staffing",
      "url": "https://vergoltd.com/hire/private-parties",
      "description": "Waiting staff, bar staff and kitchen porters for birthdays, anniversaries, house and garden parties across London.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      }
    },
    it.faqJsonLd("hire/private-parties")
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Private parties</span>
      <h1>Private party staff hire in London</h1>
      <p class="lede">Birthdays, anniversaries, house and garden parties. You host, we look after the drinks and the clear-up.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <section class="section shell" aria-labelledby="theparty-heading">
      <h2 id="theparty-heading" class="section-label">How the party runs</h2>
      <ul class="check-list">
        <li><strong>Before:</strong> glasses out, bar set up, ready when the first guest arrives</li>
        <li><strong>During:</strong> drinks poured, canapés round, empties cleared as you go</li>
        <li><strong>After:</strong> washed up, rubbish bagged, your kitchen handed back</li>
      </ul>
      <p class="section-note">On a staff booking we supply people only: food, drink and glassware stay with you. For food and bar too, see <a href="/book-an-event">full events</a>.</p>
    </section>

    <%~ it.blocks["rates"]() %>

    <%~ it.blocks["guarantees"]() %>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="section-label">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("hire/private-parties"), name: "private-parties-faq", esc: it.esc }) %>
      </div>
      <p class="link-row">Also: <a href="/hire/bar-staff">Bar staff</a> · <a href="/hire/waiting-staff">Waiting staff</a> · <a href="/hire/weddings">Weddings</a> · <a href="/special-events/christmas">Christmas parties</a></p>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Got a party coming up?" }) %>
