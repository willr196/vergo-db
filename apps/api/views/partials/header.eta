<% if (it.attrs.focused) { %>
<header class="site-header site-header--focused" id="site-header" data-shared-header>
    <div class="site-header-inner">
      <%~ include('/partials/brand', it) %>
      <a class="focused-back" href="<%= it.attrs.back || '/' %>"><%= it.attrs.label || '← Back' %></a>
      <a class="nav-call" href="tel:<%= it.site.phoneE164 %>"><%= it.site.phoneDisplay %></a>
    </div>
  </header>
<% } else { %>
<% if (it.bannerAllowed) { %><%~ include('/partials/seasonal-banner', it) %><% } %>
  <header class="site-header" id="site-header" data-shared-header>
    <div class="site-header-inner">
      <%~ include('/partials/brand', it) %>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" hidden>
        <span class="menu-toggle-bars" aria-hidden="true"></span><span class="menu-toggle-label">Menu</span>
      </button>
      <nav class="site-nav" id="site-menu" aria-label="Main">
        <ul class="nav-links">
<% it.nav.forEach(function (item) { %>
<% if (item.menu.length) { const subId = 'nav-sub' + item.href.replace(/\//g, '-'); %>
          <li class="nav-item nav-item--menu" data-nav-menu>
            <a class="nav-link" href="<%= item.href %>"<%~ item.current ? ' aria-current="page"' : '' %>><%= item.label %></a>
            <button class="nav-sub-toggle" type="button" aria-expanded="false" aria-controls="<%= subId %>" aria-label="<%= item.label %> pages"><span class="nav-caret" aria-hidden="true"></span></button>
            <div class="nav-sub" id="<%= subId %>">
<% item.menu.forEach(function (group) { %>
              <div class="nav-sub-group">
                <p class="nav-sub-heading"><%= group.heading %></p>
                <ul>
<% group.links.forEach(function (l) { %>
                  <li><a href="<%= l.href %>"<%~ l.current ? ' aria-current="page"' : '' %>><%= l.label %></a></li>
<% }) %>
                </ul>
              </div>
<% }) %>
              <a class="nav-sub-all" href="<%= item.href %>">All event staff and rates</a>
            </div>
          </li>
<% } else { %>
          <li class="nav-item"><a class="nav-link" href="<%= item.href %>"<%~ item.current ? ' aria-current="page"' : '' %>><%= item.label %></a></li>
<% } %>
<% if (item.href === '/book-an-event' && it.season.header) { %>
          <li class="nav-item nav-item--season" data-season-item><a class="nav-link nav-link--season" href="<%= it.season.header.href %>"<%~ it.path === it.season.header.href ? ' aria-current="page"' : '' %>><%= it.season.header.navLabel %></a></li>
<% } %>
<% }) %>
        </ul>
        <div class="nav-actions">
          <a class="nav-call" href="tel:<%= it.site.phoneE164 %>"><span class="nav-action-word">Call </span><%= it.site.phoneDisplay %></a>
          <a class="nav-whatsapp" href="<%= it.site.whatsappUrl %>" data-whatsapp target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn btn-primary nav-quote" href="/hire/quote">Get a quote</a>
        </div>
      </nav>
    </div>
  </header>
<% } %>
