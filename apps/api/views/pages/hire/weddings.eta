<%/* /hire/weddings: moved from public/hire/weddings.html. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Wedding Staff Hire in London | VERGO Staffing",
    "description": `Wedding staff hire in London for dry-hire venues, couples and planners. Waiting and bar staff briefed on your running order, ${it.t.HEADLINE_RATE_LOWER} per person.`,
    "ogImage": "/images/og/weddings.jpg",
    "canonical": "/hire/weddings"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Wedding staff hire",
      "serviceType": "Event and hospitality staffing",
      "url": "https://vergoltd.com/hire/weddings",
      "description": "Waiting staff, bar staff and kitchen porters for weddings across London, for couples, planners and dry-hire venues where staff are not included.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      }
    },
    it.faqJsonLd("hire/weddings")
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Weddings</span>
      <h1>Wedding staff hire in London</h1>
      <p class="lede">For couples, planners and dry-hire venues, briefed on your running order.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <section class="section shell" aria-labelledby="theday-heading">
      <h2 id="theday-heading" class="section-label">How the day runs</h2>
      <ul class="check-list">
        <li><strong>Reception:</strong> trays circulating, no bar queue during photos</li>
        <li><strong>Dinner:</strong> courses together, wine topped up, speeches respected</li>
        <li><strong>Evening:</strong> room turned, bar running, clear down after</li>
      </ul>
      <p class="section-note">On a staff booking we supply people only: catering, hire items and glassware stay with you or your suppliers. For food and bar too, see <a href="/book-an-event">full events</a>.</p>
    </section>

    <%~ it.blocks["rates"]() %>

    <%~ it.blocks["guarantees"]() %>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="section-label">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("hire/weddings"), name: "weddings-faq", esc: it.esc }) %>
      </div>
      <p class="link-row">Also: <a href="/hire/waiting-staff">Waiting staff</a> · <a href="/hire/bar-staff">Bar staff</a> · <a href="/hire/kitchen-porters">Kitchen porters</a></p>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Got a date and a venue?" }) %>
