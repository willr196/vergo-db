// ============================================
// VERGO OPS (internal admin: /ops)
// ============================================
// Compliance and commercial tracking for the employment business. Workers are
// the existing User rows (userType JOB_SEEKER); WorkerProfile carries the Ops
// fields. An Ops booking is the event; its assignments are the existing
// Booking rows (one worker, one shift), which already carry check-in/out and
// so remain the timesheet. Nothing here is deleted automatically, and these
// are tracking fields, not a substitute for payroll, pension or legal advice.

enum ClientType {
  BUSINESS_HIRER
  PRIVATE_CONSUMER
  AGENCY
  VENUE
  CATERER
  PRODUCTION
  OTHER
}

enum WorkerActiveStatus {
  ACTIVE
  INACTIVE
  LEFT
}

enum PayrollStatus {
  NOT_ADDED
  PENDING
  ACTIVE
  LEAVER
}

enum PensionStatus {
  NOT_ASSESSED
  NOT_ELIGIBLE_CURRENTLY
  ELIGIBLE
  ENROLLED
  OPTED_IN
  OPTED_OUT
  ENTITLED_WORKER
  POSTPONED
  REVIEW_REQUIRED
}

enum HolidayPayMethod {
  /// 12.07% paid with each shift's wages.
  ROLLED_UP
  /// Accrued and taken as paid leave.
  ACCRUED
}

enum OpsDocumentType {
  KEY_INFORMATION_DOCUMENT
  ZERO_HOURS_AGREEMENT
  ASSIGNMENT_CONFIRMATION
  RTW_CHECKLIST
  ONBOARDING_CHECKLIST
  /// Business hirers only. Private consumers never receive these.
  CLIENT_TERMS_OF_BUSINESS
}

enum DocumentLinkKind {
  WORKER_PACK
  CLIENT_TERMS
}

enum WorkerDocumentStatus {
  ISSUED
  ACCEPTED
  SUPERSEDED
  WITHDRAWN
}

enum OpsBookingStatus {
  DRAFT
  QUOTED
  CONFIRMED
  STAFFING
  FULLY_STAFFED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  INVOICED
  PAID
}

enum OpsCostKind {
  /// Agreed additional charge to the client (adds to revenue).
  CHARGE
  /// A direct cost of the booking.
  COST
}

enum TransferFeeStatus {
  NOT_APPLICABLE
  POSSIBLE
  INVOICED
  PAID
  WAIVED
}

model WorkerProfile {
  id                       String             @id @default(cuid())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  userId                   String             @unique
  activeStatus             WorkerActiveStatus @default(ACTIVE)
  roles                    String[]           @default([])
  qualifications           String[]           @default([])
  experienceNotes          String?            @db.VarChar(2000)
  internalNotes            String?            @db.VarChar(2000)
  /// 1 to 5, internal only.
  internalRating           Int?
  availabilityNotes        String?            @db.VarChar(1000)
  emergencyContactName     String?            @db.VarChar(120)
  emergencyContactPhone    String?            @db.VarChar(40)
  /// Admin block on top of the check history, e.g. a check under investigation.
  rtwBlocked               Boolean            @default(false)
  rtwBlockedReason         String?            @db.VarChar(500)
  payrollStatus            PayrollStatus      @default(NOT_ADDED)
  /// The payroll provider's employee reference. Not an NI number.
  payrollExternalReference String?            @db.VarChar(120)
  pensionStatus            PensionStatus      @default(NOT_ASSESSED)
  pensionLastAssessedAt    DateTime?
  pensionNotes             String?            @db.VarChar(1000)
  readyOverride            Boolean            @default(false)
  readyOverrideReason      String?            @db.VarChar(500)
  readyOverrideBy          String?            @db.VarChar(100)
  readyOverrideAt          DateTime?
  /// The usual pay rate (GBP/h), filled in when they are booked onto a shift.
  defaultPayRate           Decimal?           @db.Decimal(10, 2)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([activeStatus])
  @@index([payrollStatus])
  @@index([pensionStatus])
}

/// One version of a document's wording. Never edited once saved: a change is a
/// new version and the old one is retired, so what a worker was issued can
/// always be shown again.
model DocumentTemplate {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  type                 OpsDocumentType
  version              Int
  title                String           @db.VarChar(200)
  /// Plain text with {{placeholders}}; rendered to a print page.
  body                 String
  changeNote           String?          @db.VarChar(500)
  createdBy            String           @db.VarChar(100)
  /// Set when a newer version replaces this one (the superseded date).
  retiredAt            DateTime?
  /// The date this version takes effect, shown on the document.
  effectiveDate        DateTime?        @db.Date
  /// A material change: anyone on an earlier version must agree this one
  /// before they count as current. Otherwise earlier acceptances stand.
  requiresReacceptance Boolean          @default(false)
  /// Values from Ops settings (KID pay example, commercial terms) frozen into
  /// this version, so one version number always means one wording.
  variables            Json?
  issued               WorkerDocument[]
  clientDocuments      ClientDocument[]

  @@unique([type, version])
  @@index([type, retiredAt])
}

/// A document issued to a worker. renderedBody is the exact text issued.
model WorkerDocument {
  id                   String               @id @default(cuid())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  userId               String
  templateId           String
  type                 OpsDocumentType
  version              Int
  /// Assignment confirmations belong to one assignment (Booking row).
  bookingId            String?
  status               WorkerDocumentStatus @default(ISSUED)
  issuedAt             DateTime             @default(now())
  issuedBy             String               @db.VarChar(100)
  /// Electronic acceptance as recorded by an admin: the name the worker gave
  /// and when. Not a qualified electronic signature.
  acceptedAt           DateTime?
  acceptedName         String?              @db.VarChar(200)
  acceptanceMethod     String?              @db.VarChar(200)
  acceptanceRecordedBy String?              @db.VarChar(100)
  supersededAt         DateTime?
  renderedBody         String
  /// SHA-256 of renderedBody when issued. The snapshot is never edited.
  bodySha256           String?              @db.VarChar(64)
  /// KID only: when the worker confirmed it had been provided to them.
  acknowledgedAt       DateTime?
  acknowledgedVia      String?              @db.VarChar(60)
  /// Self-service acceptance: the statement ticked, the link used, the
  /// worker's own login if they were signed in, and the request details.
  acceptanceStatement  String?              @db.VarChar(500)
  acceptedViaLinkId    String?              @db.VarChar(40)
  acceptedAuthUserId   String?              @db.VarChar(40)
  acceptanceIp         String?              @db.VarChar(64)
  acceptanceUserAgent  String?              @db.VarChar(300)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  template             DocumentTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  booking              Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@index([bookingId])
  @@index([status])
}

model OpsBooking {
  id                       String             @id @default(cuid())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  /// VB-2026-0001
  reference                String             @unique @db.VarChar(20)
  clientId                 String
  quoteRequestId           String?
  bookingType              String?            @db.VarChar(80)
  eventType                String?            @db.VarChar(120)
  venue                    String?            @db.VarChar(200)
  address                  String?            @db.VarChar(500)
  /// London calendar date of the event.
  eventDate                DateTime           @db.Date
  /// HH:MM, London time.
  startTime                String             @db.VarChar(5)
  expectedFinish           String             @db.VarChar(5)
  actualFinish             String?            @db.VarChar(5)
  guestNumbers             Int?
  onSiteContactName        String?            @db.VarChar(120)
  onSiteContactPhone       String?            @db.VarChar(40)
  vergoLead                String?            @db.VarChar(120)
  status                   OpsBookingStatus   @default(DRAFT)
  notes                    String?            @db.VarChar(4000)
  /// Snapshot when created for a private consumer: B2B terms do not apply and
  /// separate consumer booking terms are needed.
  consumerTermsRequired    Boolean            @default(false)
  termsVersionAtBooking    String?            @db.VarChar(40)
  /// Payment before the event (e.g. a first booking), and the days allowed
  /// after invoice otherwise. Empty uses the Ops commercial default.
  advancePaymentRequired   Boolean            @default(false)
  paymentTermsDays         Int?
  invoiceRef               String?            @db.VarChar(80)
  invoicedAt               DateTime?
  paidAt                   DateTime?
  /// Actual payroll figures entered once payroll has run; they replace the
  /// estimate in the profit view. Whole pence.
  actualWagesPence         Int?
  actualHolidayPayPence    Int?
  actualEmployerCostsPence Int?
  actualPayrollNote        String?            @db.VarChar(500)
  actualPayrollRecordedBy  String?            @db.VarChar(100)
  actualPayrollRecordedAt  DateTime?
  client                   Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quoteRequest             QuoteRequest?      @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  requirements             OpsRequirement[]
  costs                    OpsBookingCost[]
  assignments              Booking[]
  scheduleItems            OpsScheduleItem[]
  /// Set when this booking is one day of a repeating booking.
  seriesId                 String?
  series                   OpsBookingSeries?  @relation("SeriesDays", fields: [seriesId], references: [id], onDelete: SetNull)
  /// Repeating bookings that copy this booking for each new day.
  patternFor               OpsBookingSeries[] @relation("SeriesPattern")

  @@unique([seriesId, eventDate])
  @@index([clientId])
  @@index([eventDate])
  @@index([status])
}

/// A booking that repeats on set weekdays (an ongoing contract). Ops keeps
/// real OpsBooking days created aheadWeeks in advance, each a copy of the
/// pattern booking (times, venue, roles, rates, running order; never staff),
/// so the rota, calendar, staffing and invoicing treat every day normally.
model OpsBookingSeries {
  id               String       @id @default(cuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  clientId         String
  /// The booking each new day is copied from.
  patternBookingId String
  /// 1 = Monday .. 7 = Sunday (ISO weekday numbering).
  weekdays         Int[]
  startsOn         DateTime     @db.Date
  /// Last day of the run; empty repeats until stopped.
  endsOn           DateTime?    @db.Date
  aheadWeeks       Int          @default(6)
  /// The latest day considered so far; new days are only ever added after it.
  generatedThrough DateTime?    @db.Date
  active           Boolean      @default(true)
  createdBy        String?      @db.VarChar(100)
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  patternBooking   OpsBooking   @relation("SeriesPattern", fields: [patternBookingId], references: [id], onDelete: Restrict)
  days             OpsBooking[] @relation("SeriesDays")

  @@index([active])
  @@index([clientId])
}

model OpsRequirement {
  id                      String     @id @default(cuid())
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  opsBookingId            String
  role                    String     @db.VarChar(80)
  quantity                Int
  clientChargeRate        Decimal    @db.Decimal(10, 2)
  workerPayRate           Decimal    @db.Decimal(10, 2)
  /// Falls back to the site-wide minimum when empty.
  minimumHours            Decimal?   @db.Decimal(5, 2)
  /// Multiplier on the charge rate for hours after midnight, e.g. 1.25.
  afterMidnightMultiplier Decimal?   @db.Decimal(4, 2)
  /// Per worker, per shift.
  travelContribution      Decimal?   @db.Decimal(10, 2)
  /// Per worker, per shift.
  expenses                Decimal?   @db.Decimal(10, 2)
  breakMins               Int        @default(0)
  requiredExperience      String?    @db.VarChar(500)
  requiredQualifications  String[]   @default([])
  dressCode               String?    @db.VarChar(500)
  equipment               String?    @db.VarChar(500)
  duties                  String?    @db.VarChar(2000)
  healthSafetyRisks       String?    @db.VarChar(2000)
  riskControls            String?    @db.VarChar(2000)
  breakInfo               String?    @db.VarChar(500)
  /// Booking-specific charges the Terms of Business refer to.
  overtimeChargeRate      Decimal?   @db.Decimal(10, 2)
  /// Hours per worker after which the overtime rate applies.
  overtimeAfterHours      Decimal?   @db.Decimal(5, 2)
  /// Specialist rates or other agreed charges, in words.
  otherCharges            String?    @db.VarChar(500)
  opsBooking              OpsBooking @relation(fields: [opsBookingId], references: [id], onDelete: Restrict)
  assignments             Booking[]

  @@index([opsBookingId])
}

model OpsBookingCost {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  opsBookingId String
  kind         OpsCostKind
  /// equipment, costume, food_drink, supplier, worker_other, other, charge
  category     String      @db.VarChar(40)
  description  String      @db.VarChar(300)
  amountPence  Int
  createdBy    String      @db.VarChar(100)
  opsBooking   OpsBooking  @relation(fields: [opsBookingId], references: [id], onDelete: Restrict)

  @@index([opsBookingId])
