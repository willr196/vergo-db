<%/* /hire/corporate-events: corporate and large events. No headcounts or client names: Will has none to publish yet. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Corporate & Large Event Staff in London | VERGO Staffing",
    "description": `Staff for corporate and large events in London: conferences, awards dinners, launches and festivals. Supervisors on request, ${it.t.HEADLINE_RATE_LOWER}.`,
    "ogImage": "/images/og/hire.jpg",
    "canonical": "/hire/corporate-events"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Corporate and large event staffing",
      "serviceType": "Event and hospitality staffing",
      "url": "https://vergoltd.com/hire/corporate-events",
      "description": "Waiting staff, bar staff, kitchen porters, runners and hosts for conferences, awards dinners, product launches, exhibitions and festivals across London, with a supervisor on request.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      }
    },
    it.faqJsonLd("hire/corporate-events")
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Corporate and large events</span>
      <h1>Corporate and large event staff in London</h1>
      <p class="lede">Conferences, awards dinners, launches, exhibitions and festivals. One team, one point of contact.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <section class="section shell" aria-labelledby="howwerun-heading">
      <h2 id="howwerun-heading" class="section-label">How a large booking runs</h2>
      <ul class="check-list">
        <li><strong>One booking, every role:</strong> waiting, bar, kitchen porters, runners and hosts</li>
        <li><strong>A supervisor on request:</strong> runs the team on the day and is your one contact</li>
        <li><strong>Briefed before the doors open:</strong> running order, floor plan, dress code</li>
      </ul>
      <p class="section-note">On a staff booking we supply people only: catering, bars and hire items stay with you, your caterer or the venue. <%= it.t.SENIOR_ROLES %></p>
    </section>

    <%~ it.blocks["rates"]() %>

    <%~ it.blocks["guarantees"]() %>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="section-label">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("hire/corporate-events"), name: "corporate-faq", esc: it.esc }) %>
      </div>
      <p class="link-row">Also: <a href="/hire/waiting-staff">Waiting staff</a> · <a href="/hire/bar-staff">Bar staff</a> · <a href="/special-events/christmas">Christmas parties</a></p>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Got an event coming up?" }) %>
