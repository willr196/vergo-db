<%/* /work: moved from public/work.html. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Event & Hospitality Work in London | VERGO Staffing",
    "description": "Properly employed hospitality and event work across London. Payslips, holiday pay, pension.",
    "ogImage": "/images/og/work.jpg",
    "canonical": "/work"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://vergoltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Work with VERGO",
          "item": "https://vergoltd.com/work"
        }
      ]
    }
  ]
}) %>
    <section class="page-hero-plain shell">
      <span class="eyebrow">Work for us</span>
      <h1>Event shifts in London</h1>
      <p class="lede">Weddings, corporate functions, private parties and production catering.</p>
      <div class="btn-row">
        <a href="/work/apply" class="btn btn-primary">Apply now</a>
      </div>
    </section>

    <%~ it.blocks["open-shifts"]() %>

    <section class="section shell" aria-labelledby="get-heading">
      <h2 id="get-heading" class="section-label">What you get</h2>
      <table class="pay-table">
        <tbody>
          <tr><th scope="row">Pay</th><td><%~ it.t.WORKER_PAY_LINE %></td></tr>
          <tr><th scope="row">Holiday pay</th><td>Itemised on every payslip</td></tr>
          <tr><th scope="row">Employment</th><td>PAYE. Payslips, and a pension where it applies</td></tr>
          <tr><th scope="row">Roles</th><td>Waiting staff, bar staff, kitchen porters, runners, hosts and front of house, chefs and cooks</td></tr>
        </tbody>
      </table>
    </section>

    <section class="section shell" aria-labelledby="ask-heading">
      <h2 id="ask-heading" class="section-label">What we ask</h2>
      <ul class="check-list">
        <li>Turn up on time, every time.</li>
        <li>Can't make it? Tell us early.</li>
        <li>Be honest about your experience.</li>
      </ul>
    </section>

    <section class="section shell" aria-labelledby="howjoin-heading">
      <h2 id="howjoin-heading" class="section-label">How to join</h2>
      <div class="step-grid step-grid--4">
        <div class="step">
          <div class="step-number">01</div>
          <h3>Apply</h3>
          <p>Two minutes, online.</p>
        </div>
        <div class="step">
          <div class="step-number">02</div>
          <h3>Have a chat</h3>
          <p>Twenty minutes, in person or video.</p>
        </div>
        <div class="step">
          <div class="step-number">03</div>
          <h3>Bring your documents</h3>
          <p>Right to work, NI number, bank details.</p>
        </div>
        <div class="step">
          <div class="step-number">04</div>
          <h3>Pick up shifts</h3>
          <p>Work that fits your availability.</p>
        </div>
      </div>
    </section>

    <section class="section shell" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="section-label">Questions</h2>
      <div class="faq-list">
        <%~ include('/partials/faq', { items: it.faqs("work"), name: "work-faq", esc: it.esc }) %>
      </div>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Ready to start?", "button": "Apply now", "href": "/work/apply" }) %>
