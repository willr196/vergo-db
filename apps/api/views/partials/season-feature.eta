<%/*
  The homepage's seasonal strip: the season in the header right now (so
  Halloween until 31 October, then Christmas to 20 December), or nothing.
  Kept small on purpose: a thumbnail from the photo tagged "season-<key>",
  the heading and a text link. No prices: the homepage carries none, so
  the promo's price lines show on its own page only.
*/%>
<% const promo = it.season.header; %>
<% if (promo) { %>
<% const photo = it.photos('season-' + promo.key)[0]; const srcs = photo ? it.photoSources(photo) : null; %>
<section class="section-tight shell season-feature" data-season="<%= promo.key %>" aria-labelledby="<%= promo.key %>-heading">
      <div class="season-feature-row">
<% if (photo) { %>
        <img src="<%= srcs.src %>"<% if (srcs.srcset) { %> srcset="<%= srcs.srcset %>" sizes="160px"<% } %> width="<%= photo.width %>" height="<%= photo.height %>" loading="lazy" alt="<%= photo.alt %>">
<% } %>
        <div>
          <h2 id="<%= promo.key %>-heading"><%= promo.homeHeading %></h2>
<% if (promo.homeCtaLabel && promo.homeCtaHref) { %>
          <a href="<%= promo.homeCtaHref %>" class="season-link"><%= promo.homeCtaLabel %> &rarr;</a>
<% } %>
        </div>
      </div>
    </section>
<% } %>
