<%/* /hire: moved from public/hire.html. Shared blocks, prices and contact details come from it.blocks and it.t. */%>
<% layout('/layouts/base', {
  meta: {
    "title": "Hire Event Staff in London | VERGO Staffing",
    "description": `Waiting, bar and kitchen staff, runners and hosts across London. ${it.t.HEADLINE_RATE} per person, names the same day, a replacement within the hour.`,
    "ogImage": "/images/og/hire.jpg",
    "canonical": "/hire"
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Event and hospitality staffing",
      "serviceType": "Event and hospitality staffing",
      "url": "https://vergoltd.com/hire",
      "description": "Waiting staff, bar staff, kitchen porters, runners, hosts and front of house for events across London, with a replacement within the hour on a no-show.",
      "areaServed": {
        "@type": "City",
        "name": "London"
      },
      "provider": {
        "@id": "https://vergoltd.com/#organization"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://vergoltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Hire event staff",
          "item": "https://vergoltd.com/hire"
        }
      ]
    }
  ]
}) %>
    <section class="page-hero-plain shell">
      <h1>Event staff for hire in London</h1>
      <p class="home-slogan"><%~ it.t.SLOGAN %></p>
      <p class="lede"><a href="/hire/waiting-staff">Waiting</a>, <a href="/hire/bar-staff">bar</a>, <a href="/hire/kitchen-porters">kitchen porters</a>, runners, hosts. Food and bar too: see <a href="/book-an-event">full events</a>.</p>
      <div class="btn-row">
        <a href="/hire/quote" class="btn btn-primary">Get a quote</a>
      </div>
    </section>

    <%~ it.blocks["guarantees"]() %>

    <%~ it.blocks["rates"]() %>

    <section class="section shell" aria-labelledby="howitworks-heading">
      <h2 id="howitworks-heading" class="section-label">How it works</h2>
      <div class="step-grid step-grid--3">
        <div class="step">
          <div class="step-number">01</div>
          <h3>Send details</h3>
          <p>Date, times, roles.</p>
        </div>
        <div class="step">
          <div class="step-number">02</div>
          <h3>Get names</h3>
          <p>Names, not numbers.</p>
        </div>
        <div class="step">
          <div class="step-number">03</div>
          <h3>They arrive briefed</h3>
          <p>Venue and running order.</p>
        </div>
      </div>
    </section>

    <%~ it.blocks["working-with-us"]() %>

    <%~ it.blocks["testimonials"]() %>

    <%~ it.blocks["recent-work"]() %>

    <section class="section shell" aria-labelledby="byoccasion-heading">
      <h2 id="byoccasion-heading" class="section-label">By occasion</h2>
      <ul class="link-tiles">
        <li><a href="/hire/weddings">Weddings</a></li>
        <li><a href="/hire/production-catering">Film and TV</a></li>
        <li><a href="/special-events/christmas">Christmas</a></li>
        <li><a href="/special-events">Themed events</a></li>
      </ul>
    </section>

    <%~ it.blocks["cta"]({ "heading": "Got a date?" }) %>
